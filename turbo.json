{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**", ".output/**"],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**"],
      "cache": true,
      "outputs": []
    },
    "@makanmasak/api#typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**"],
      "cache": true,
      "outputs": ["node_modules/.cache/tsc/typecheck.tsbuildinfo"]
    },
    "@makanmasak/database#typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**"],
      "cache": true,
      "outputs": ["node_modules/.cache/tsc/typecheck.tsbuildinfo"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**"],
      "cache": true,
      "outputs": []
    },
    // Inputs stay at the turbo default minus prose: narrowing them to an
    // explicit allow-list (src/**, tests/**, …) would silently miss packages
    // whose tests live outside those directories — packages/shared keeps its
    // tests in utils/ — and a missed input means a stale cache HIT reported as
    // a pass. Cross-package changes still invalidate correctly via `^build`.
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**"],
      "cache": true,
      // No outputs: every package's `test` script is a plain `vitest run`.
      // Coverage is produced by the separate `test:coverage` scripts, and
      // claiming `coverage/**` here only made turbo warn "no output files
      // found" for every package on every run.
      "outputs": []
    },
    "test:real-integration": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "migrations_fresh/**",
        "vitest.real-integration.config.ts",
        "package.json"
      ],
      "cache": true,
      "outputs": []
    },
    "deploy": {
      "dependsOn": ["build", "typecheck", "lint"],
      "cache": false
    }
  },
  "globalDependencies": [
    ".env",
    ".env.local",
    "tsconfig.json",
    "wrangler.toml",
    // The per-package vitest worker ceiling lives here. It sits outside every
    // package's $TURBO_DEFAULT$ inputs, so without this line a change to the
    // ceiling would come back as a stale cache HIT instead of re-running.
    "vitest.shared.ts"
  ],
  "globalEnv": ["NODE_ENV", "CI"],
  // A parallelism knob only: it changes how many workers run, never what a
  // test asserts, so it is passed through WITHOUT entering the cache key.
  // turbo defaults to strict env mode and drops any variable not named here,
  // which is why exporting VITEST_MAX_WORKERS alone had no effect on tasks.
  "globalPassThroughEnv": ["VITEST_MAX_WORKERS"]
}

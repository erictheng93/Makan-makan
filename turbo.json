{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**", ".output/**"],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": []
    },
    "@makanmasak/api#typecheck": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["node_modules/.cache/tsc/typecheck.tsbuildinfo"]
    },
    "@makanmasak/database#typecheck": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["node_modules/.cache/tsc/typecheck.tsbuildinfo"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["coverage/**"]
    },
    "test:real-integration": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "migrations_fresh/**",
        "vitest.real-integration.config.ts",
        "package.json"
      ],
      "cache": true,
      "outputs": []
    },
    "deploy": {
      "dependsOn": ["build", "typecheck", "lint"],
      "cache": false
    }
  },
  "globalDependencies": [
    ".env",
    ".env.local",
    "tsconfig.json",
    "wrangler.toml"
  ],
  "globalEnv": ["NODE_ENV", "CI"]
}

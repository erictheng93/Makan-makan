    is_paid,
    color_code, sort_order, is_active, is_system_type
) VALUES (
    'FAMILY_CARE',
    '家庭照顧假 (Family Care Leave)',
    '依性別工作平等法第20條，受僱者於其家庭成員預防接種、發生嚴重之疾病或其他重大事故須親自照顧時，得請家庭照顧假；其請假日數併入事假計算，全年以7日為限。家庭照顧假薪資之計算，依各該事假規定辦理（即無薪）。',
    7,
    'yearly',
    1, 1, 1,
    0,  -- 無薪
    '#14B8A6',
    8, 1, 1
);


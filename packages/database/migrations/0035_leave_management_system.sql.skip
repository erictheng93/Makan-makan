    is_paid, requires_documentation,
    color_code, sort_order, is_active, is_system_type
) VALUES (
    'BEREAVEMENT',
    '喪假 (Bereavement Leave)',
    '依勞工請假規則第3條，父母、養父母、繼父母、配偶喪亡者，給予喪假8日；祖父母、子女、配偶之父母、配偶之養父母或繼父母喪亡者，給予喪假6日；兄弟姊妹喪亡者，給予喪假3日。工資照給。',
    0,
    'none',
    1, 1, 0,  -- 緊急情況，可不提前
    1, 1,
    '#6B7280',  -- 灰色

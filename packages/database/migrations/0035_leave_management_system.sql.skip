    gender_restriction,
    color_code, sort_order, is_active, is_system_type
) VALUES (
    'PATERNITY',
    '陪產假 (Paternity Leave)',
    '依性別工作平等法第15條，受僱者於其配偶分娩時，雇主應給予陪產檢及陪產假7日，得分次申請。但應於配偶分娩日前後合計15日期間內請畢，且每次請假應至少半日。陪產假期間工資照給。',
    7,
    'none',
    1, 1, 3,
    1, 1,
    'male',
    '#8B5CF6',
    7, 1, 1
);


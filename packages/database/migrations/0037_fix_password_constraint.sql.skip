-- Migration: 修復 password 欄位約束
-- Version: 0037
-- Date: 2025-10-10
-- Description: 移除舊 password 欄位的 NOT NULL 約束，允許使用 password_hash

-- SQLite 不支持直接 ALTER COLUMN，需要重建表
-- 步驟：
-- 1. 禁用外鍵約束
-- 2. 創建新的 users 表（password 欄位為 nullable）
-- 3. 複製所有數據
-- 4. 刪除舊表
-- 5. 重命名新表
-- 6. 重新啟用外鍵約束

-- 禁用外鍵約束
PRAGMA foreign_keys = OFF;

-- 創建臨時新表
CREATE TABLE users_new (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT NOT NULL UNIQUE,
    password TEXT,  -- 改為 nullable
    email TEXT,
    full_name TEXT,
    role INTEGER NOT NULL DEFAULT 4,
    restaurant_id INTEGER,
    status TEXT DEFAULT 'active' CHECK (status IN ('active', 'inactive', 'suspended')),
    last_login_at DATETIME,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    password_migrated BOOLEAN DEFAULT 0,
    migration_date DATETIME DEFAULT NULL,
    password_hash TEXT,
    is_active INTEGER DEFAULT 1,
    phone TEXT,
    address TEXT,
    date_of_birth TEXT,
    profile_image_url TEXT,
    is_verified INTEGER DEFAULT 0,
    preferences TEXT,
    total_orders INTEGER DEFAULT 0,
    total_spent INTEGER DEFAULT 0,
    password_changed_at INTEGER,
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(id) ON DELETE CASCADE
);

-- 複製所有現有數據
INSERT INTO users_new SELECT * FROM users;

-- 刪除舊表
DROP TABLE users;

-- 重命名新表
ALTER TABLE users_new RENAME TO users;

-- 重建索引
CREATE UNIQUE INDEX IF NOT EXISTS users_username_idx ON users(username);
CREATE INDEX IF NOT EXISTS users_restaurant_id_idx ON users(restaurant_id);
CREATE INDEX IF NOT EXISTS users_role_idx ON users(role);
CREATE INDEX IF NOT EXISTS users_email_idx ON users(email);

-- 重新啟用外鍵約束
PRAGMA foreign_keys = ON;

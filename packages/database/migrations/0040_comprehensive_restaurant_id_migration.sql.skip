-- =====================================================
-- Migration: 完整的 restaurant_id 遷移 (INTEGER → TEXT)
-- Version: 0040
-- Date: 2025-10-27
-- Description: 一次性遷移所有 45 張包含 restaurant_id 的表
-- Strategy: 新表策略 - 創建 _new 表，遷移數據，替換舊表
-- =====================================================

-- 禁用外鍵約束（在遷移期間）
PRAGMA foreign_keys=OFF;

-- =====================================================
-- 階段 1: 創建所有新表結構（使用 TEXT restaurant_id）
-- =====================================================

-- 重要說明：
-- 1. 所有新表使用 _new 後綴
-- 2. restaurant_id 欄位改為 TEXT 類型
-- 3. 外鍵約束指向 restaurants(public_id)
-- 4. 已使用 TEXT 的表（9張）不需要修改結構

-- =====================================================
-- 核心業務表 (6張)
-- =====================================================

-- 1. users 表
CREATE TABLE IF NOT EXISTS users_new (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT NOT NULL UNIQUE,
    email TEXT,
    phone TEXT,
    full_name TEXT NOT NULL,
    password TEXT,
    password_hash TEXT NOT NULL,
    role INTEGER NOT NULL DEFAULT 5,
    restaurant_id TEXT,  -- INTEGER → TEXT
    address TEXT,
    date_of_birth TEXT,
    profile_image_url TEXT,
    is_active INTEGER NOT NULL DEFAULT 1,
    is_verified INTEGER NOT NULL DEFAULT 0,
    preferences TEXT,
    total_orders INTEGER NOT NULL DEFAULT 0,
    total_spent INTEGER NOT NULL DEFAULT 0,
    last_login_at INTEGER,
    password_changed_at INTEGER,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    password_migrated BOOLEAN DEFAULT 0,
    migration_date DATETIME DEFAULT NULL,
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE
);

-- 2. categories 表
CREATE TABLE IF NOT EXISTS categories_new (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    restaurant_id TEXT NOT NULL,  -- INTEGER → TEXT
    name TEXT NOT NULL,
    description TEXT,
    sort_order INTEGER NOT NULL DEFAULT 0,
    is_active INTEGER NOT NULL DEFAULT 1,
    is_visible INTEGER NOT NULL DEFAULT 1,
    image_url TEXT,
    icon_url TEXT,
    available_hours TEXT,
    item_count INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE
);

-- 3. menu_items 表
CREATE TABLE IF NOT EXISTS menu_items_new (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    restaurant_id TEXT NOT NULL,  -- INTEGER → TEXT
    category_id INTEGER NOT NULL,
    name TEXT NOT NULL,
    description TEXT,
    ingredients TEXT,
    price REAL NOT NULL,
    original_price REAL,
    cost_price REAL,
    image_url TEXT,
    image_variants TEXT,
    is_available INTEGER NOT NULL DEFAULT 1,
    is_featured INTEGER NOT NULL DEFAULT 0,
    is_popular INTEGER NOT NULL DEFAULT 0,
    sort_order INTEGER NOT NULL DEFAULT 0,
    inventory_count INTEGER,
    min_inventory_alert INTEGER DEFAULT 5,
    spice_level INTEGER NOT NULL DEFAULT 0,
    preparation_time INTEGER DEFAULT 15,
    calories INTEGER,
    dietary_info TEXT,
    allergens TEXT,
    options TEXT,
    available_hours TEXT,
    order_count INTEGER NOT NULL DEFAULT 0,
    rating REAL DEFAULT 0,
    review_count INTEGER NOT NULL DEFAULT 0,
    view_count INTEGER NOT NULL DEFAULT 0,
    tags TEXT,
    keywords TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE,
    FOREIGN KEY (category_id) REFERENCES categories_new(id) ON DELETE CASCADE
);

-- 4. tables 表
CREATE TABLE IF NOT EXISTS tables_new (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    restaurant_id TEXT NOT NULL,  -- INTEGER → TEXT
    table_number TEXT NOT NULL,
    area TEXT,
    capacity INTEGER NOT NULL DEFAULT 4,
    status TEXT NOT NULL DEFAULT 'available',
    is_active INTEGER NOT NULL DEFAULT 1,
    qr_code_id TEXT,
    qr_code_url TEXT,
    sort_order INTEGER DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE
);

-- 5. orders 表
CREATE TABLE IF NOT EXISTS orders_new (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    restaurant_id TEXT NOT NULL,  -- INTEGER → TEXT
    table_id INTEGER NOT NULL,
    customer_id INTEGER,
    order_number TEXT NOT NULL UNIQUE,
    status TEXT NOT NULL DEFAULT 'pending',
    order_type TEXT DEFAULT 'table',
    subtotal REAL NOT NULL,
    tax_amount REAL NOT NULL DEFAULT 0,
    service_charge REAL NOT NULL DEFAULT 0,
    discount_amount REAL NOT NULL DEFAULT 0,
    total_amount REAL NOT NULL,
    customer_info TEXT,
    estimated_prep_time INTEGER,
    actual_prep_time INTEGER,
    confirmed_at INTEGER,
    preparing_at INTEGER,
    ready_at INTEGER,
    delivered_at INTEGER,
    paid_at INTEGER,
    cancelled_at INTEGER,
    payment_method TEXT,
    payment_status TEXT DEFAULT 'pending',
    payment_transaction_id TEXT,
    coupon_code TEXT,
    promotion_ids TEXT,
    rating INTEGER,
    review_comment TEXT,
    reviewed_at INTEGER,
    notes TEXT,
    internal_notes TEXT,
    cancellation_reason TEXT,
    refund_amount REAL,
    delivery_info TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE,
    FOREIGN KEY (table_id) REFERENCES tables_new(id) ON DELETE RESTRICT,
    FOREIGN KEY (customer_id) REFERENCES users_new(id)
);

-- =====================================================
-- 排班系統表 (9張)
-- =====================================================

-- 6. shift_templates 表
CREATE TABLE IF NOT EXISTS shift_templates_new (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    restaurant_id TEXT NOT NULL,  -- INTEGER → TEXT
    name TEXT NOT NULL,
    description TEXT,
    shift_type TEXT NOT NULL DEFAULT 'regular',
    start_time TEXT NOT NULL,
    end_time TEXT NOT NULL,
    duration_minutes INTEGER NOT NULL,
    is_split_shift INTEGER NOT NULL DEFAULT 0,
    break_start_time TEXT,
    break_end_time TEXT,
    break_duration_minutes INTEGER DEFAULT 0,
    applicable_days TEXT DEFAULT '[]',
    min_employees INTEGER DEFAULT 1,
    max_employees INTEGER DEFAULT 10,
    hourly_rate REAL,
    overtime_multiplier REAL DEFAULT 1.5,
    color_code TEXT DEFAULT '#3B82F6',
    icon TEXT,
    sort_order INTEGER DEFAULT 0,
    is_active INTEGER NOT NULL DEFAULT 1,
    created_by INTEGER,
    updated_by INTEGER,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE,
    FOREIGN KEY (created_by) REFERENCES users_new(id) ON DELETE SET NULL,
    FOREIGN KEY (updated_by) REFERENCES users_new(id) ON DELETE SET NULL
);

-- 7. employee_schedules 表
CREATE TABLE IF NOT EXISTS employee_schedules_new (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    restaurant_id TEXT NOT NULL,  -- INTEGER → TEXT
    employee_id INTEGER NOT NULL,
    shift_template_id INTEGER,
    work_date TEXT NOT NULL,
    actual_start_time TEXT,
    actual_end_time TEXT,
    status TEXT NOT NULL DEFAULT 'scheduled',
    clock_in_time INTEGER,
    clock_out_time INTEGER,
    actual_work_minutes INTEGER,
    break_minutes INTEGER DEFAULT 0,
    overtime_minutes INTEGER DEFAULT 0,
    notes TEXT,
    position TEXT,
    location TEXT,
    confirmed_by INTEGER,
    confirmed_at INTEGER,
    created_by INTEGER,
    updated_by INTEGER,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE,
    FOREIGN KEY (employee_id) REFERENCES users_new(id) ON DELETE CASCADE,
    FOREIGN KEY (shift_template_id) REFERENCES shift_templates_new(id) ON DELETE SET NULL,
    FOREIGN KEY (confirmed_by) REFERENCES users_new(id) ON DELETE SET NULL,
    FOREIGN KEY (created_by) REFERENCES users_new(id) ON DELETE SET NULL,
    FOREIGN KEY (updated_by) REFERENCES users_new(id) ON DELETE SET NULL
);

-- 8. scheduling_rules 表
CREATE TABLE IF NOT EXISTS scheduling_rules_new (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    restaurant_id TEXT NOT NULL,  -- INTEGER → TEXT
    rule_name TEXT NOT NULL,
    rule_type TEXT NOT NULL,
    description TEXT,
    rule_config TEXT DEFAULT '{}',
    applies_to_roles TEXT,
    applies_to_employees TEXT,
    priority INTEGER NOT NULL DEFAULT 0,
    severity TEXT NOT NULL DEFAULT 'warning',
    is_system_rule INTEGER NOT NULL DEFAULT 0,
    is_active INTEGER NOT NULL DEFAULT 1,
    created_by INTEGER,
    updated_by INTEGER,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE,
    FOREIGN KEY (created_by) REFERENCES users_new(id) ON DELETE SET NULL,
    FOREIGN KEY (updated_by) REFERENCES users_new(id) ON DELETE SET NULL
);

-- 9. scheduling_conflicts 表
CREATE TABLE IF NOT EXISTS scheduling_conflicts_new (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    restaurant_id TEXT NOT NULL,  -- INTEGER → TEXT
    conflict_type TEXT NOT NULL,
    severity TEXT NOT NULL,
    message TEXT NOT NULL,
    details TEXT,
    schedule_ids TEXT,
    employee_ids TEXT,
    rule_id INTEGER,
    status TEXT NOT NULL DEFAULT 'unresolved',
    resolved_by INTEGER,
    resolved_at INTEGER,
    resolution_notes TEXT,
    detected_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE,
    FOREIGN KEY (rule_id) REFERENCES scheduling_rules_new(id) ON DELETE SET NULL,
    FOREIGN KEY (resolved_by) REFERENCES users_new(id) ON DELETE SET NULL
);

-- 10. schedule_swap_requests 表
CREATE TABLE IF NOT EXISTS schedule_swap_requests_new (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    restaurant_id TEXT NOT NULL,  -- INTEGER → TEXT
    requester_employee_id INTEGER NOT NULL,
    requester_schedule_id INTEGER NOT NULL,
    target_employee_id INTEGER,
    target_schedule_id INTEGER,
    request_type TEXT NOT NULL,
    reason TEXT NOT NULL,
    urgency TEXT NOT NULL DEFAULT 'normal',
    is_open_request INTEGER NOT NULL DEFAULT 0,
    status TEXT NOT NULL DEFAULT 'pending',
    accepted_by INTEGER,
    accepted_at INTEGER,
    approved_by INTEGER,
    approved_at INTEGER,
    rejected_by INTEGER,
    rejected_at INTEGER,
    rejection_reason TEXT,
    expires_at INTEGER,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE,
    FOREIGN KEY (requester_employee_id) REFERENCES users_new(id) ON DELETE CASCADE,
    FOREIGN KEY (requester_schedule_id) REFERENCES employee_schedules_new(id) ON DELETE CASCADE,
    FOREIGN KEY (target_employee_id) REFERENCES users_new(id) ON DELETE SET NULL,
    FOREIGN KEY (target_schedule_id) REFERENCES employee_schedules_new(id) ON DELETE SET NULL,
    FOREIGN KEY (accepted_by) REFERENCES users_new(id) ON DELETE SET NULL,
    FOREIGN KEY (approved_by) REFERENCES users_new(id) ON DELETE SET NULL,
    FOREIGN KEY (rejected_by) REFERENCES users_new(id) ON DELETE SET NULL
);

-- 11. employee_availability 表
CREATE TABLE IF NOT EXISTS employee_availability_new (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    restaurant_id TEXT NOT NULL,  -- INTEGER → TEXT
    employee_id INTEGER NOT NULL,
    availability_type TEXT NOT NULL DEFAULT 'preferred',
    day_of_week INTEGER,
    start_date TEXT,
    end_date TEXT,
    start_time TEXT,
    end_time TEXT,
    is_recurring INTEGER NOT NULL DEFAULT 1,
    notes TEXT,
    is_active INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE,
    FOREIGN KEY (employee_id) REFERENCES users_new(id) ON DELETE CASCADE
);

-- 12. leave_requests 表
CREATE TABLE IF NOT EXISTS leave_requests_new (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    employee_id INTEGER NOT NULL,
    leave_type_id INTEGER NOT NULL,
    restaurant_id TEXT NOT NULL,  -- INTEGER → TEXT
    start_date TEXT NOT NULL,
    end_date TEXT NOT NULL,
    start_period TEXT NOT NULL DEFAULT 'full',
    end_period TEXT NOT NULL DEFAULT 'full',
    days_count REAL NOT NULL,
    reason TEXT NOT NULL,
    attachments TEXT DEFAULT '[]',
    status TEXT NOT NULL DEFAULT 'pending',
    approval_chain TEXT DEFAULT '[]',
    current_approval_level INTEGER DEFAULT 0,
    required_approval_levels INTEGER NOT NULL DEFAULT 1,
    final_approver_id INTEGER,
    final_approved_at INTEGER,
    rejection_reason TEXT,
    cancelled_by INTEGER,
    cancelled_at INTEGER,
    cancellation_reason TEXT,
    affects_schedules TEXT DEFAULT '[]',
    schedule_conflicts_resolved INTEGER DEFAULT 0,
    notes TEXT,
    admin_notes TEXT,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    submitted_at INTEGER,
    FOREIGN KEY (employee_id) REFERENCES users_new(id) ON DELETE CASCADE,
    FOREIGN KEY (leave_type_id) REFERENCES leave_types(id) ON DELETE CASCADE,
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE,
    FOREIGN KEY (final_approver_id) REFERENCES users_new(id) ON DELETE SET NULL,
    FOREIGN KEY (cancelled_by) REFERENCES users_new(id) ON DELETE SET NULL
);

-- 13. leave_approval_rules 表
CREATE TABLE IF NOT EXISTS leave_approval_rules_new (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    restaurant_id TEXT NOT NULL,  -- INTEGER → TEXT
    leave_type_id INTEGER,
    rule_name TEXT NOT NULL,
    description TEXT,
    approval_level INTEGER NOT NULL,
    approver_role TEXT,
    approver_user_id INTEGER,
    conditions TEXT DEFAULT '{}',
    auto_approve_enabled INTEGER DEFAULT 0,
    auto_approve_conditions TEXT DEFAULT '{}',
    auto_escalate_hours INTEGER,
    notify_on_submit INTEGER DEFAULT 1,
    notify_on_approve INTEGER DEFAULT 1,
    notify_on_reject INTEGER DEFAULT 1,
    priority INTEGER DEFAULT 0,
    is_active INTEGER NOT NULL DEFAULT 1,
    created_by INTEGER,
    updated_by INTEGER,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE,
    FOREIGN KEY (leave_type_id) REFERENCES leave_types(id) ON DELETE CASCADE,
    FOREIGN KEY (approver_user_id) REFERENCES users_new(id) ON DELETE SET NULL,
    FOREIGN KEY (created_by) REFERENCES users_new(id) ON DELETE SET NULL,
    FOREIGN KEY (updated_by) REFERENCES users_new(id) ON DELETE SET NULL
);

-- 14. employee_leave_balances 表
CREATE TABLE IF NOT EXISTS employee_leave_balances_new (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    employee_id INTEGER NOT NULL,
    leave_type_id INTEGER NOT NULL,
    restaurant_id TEXT NOT NULL,  -- INTEGER → TEXT
    year INTEGER NOT NULL,
    total_days REAL NOT NULL DEFAULT 0,
    used_days REAL NOT NULL DEFAULT 0,
    pending_days REAL NOT NULL DEFAULT 0,
    carryover_from_previous REAL DEFAULT 0,
    carryover_to_next REAL DEFAULT 0,
    carryover_expires_at INTEGER,
    manual_adjustment REAL DEFAULT 0,
    adjustment_reason TEXT,
    adjusted_by INTEGER,
    adjusted_at INTEGER,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    last_updated_by INTEGER,
    FOREIGN KEY (employee_id) REFERENCES users_new(id) ON DELETE CASCADE,
    FOREIGN KEY (leave_type_id) REFERENCES leave_types(id) ON DELETE CASCADE,
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE,
    FOREIGN KEY (adjusted_by) REFERENCES users_new(id) ON DELETE SET NULL,
    FOREIGN KEY (last_updated_by) REFERENCES users_new(id) ON DELETE SET NULL
);


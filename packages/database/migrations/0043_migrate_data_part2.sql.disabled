-- 遷移 audit_logs 表數據
INSERT INTO audit_logs_new (
    id, user_id, restaurant_id, action, resource, resource_id, description, changes, ip_address, user_agent, success, error_message, execution_time_ms, created_at
) SELECT
    a.id,
    a.user_id,
    CASE
        WHEN a.restaurant_id IS NOT NULL THEN r.public_id
        ELSE NULL
    END as restaurant_id,
    a.action,
    a.resource,
    a.resource_id,
    a.description,
    a.changes,
    a.ip_address,
    a.user_agent,
    a.success,
    a.error_message,
    a.execution_time_ms,
    a.created_at
FROM audit_logs a
LEFT JOIN restaurants r ON a.restaurant_id = r.id;

-- 遷移 error_reports 表數據
INSERT INTO error_reports_new (
    id, user_id, restaurant_id, error_type, severity, error_code, error_message, error_context, original_error, user_agent, url, timestamp, created_at, resolved_at, resolved_by, resolution_notes
) SELECT
    e.id,
    e.user_id,
    CASE
        WHEN e.restaurant_id IS NOT NULL THEN r.public_id
        ELSE NULL
    END as restaurant_id,
    e.error_type,
    e.severity,
    e.error_code,
    e.error_message,
    e.error_context,
    e.original_error,
    e.user_agent,
    e.url,
    e.timestamp,
    e.created_at,
    e.resolved_at,
    e.resolved_by,
    e.resolution_notes
FROM error_reports e
LEFT JOIN restaurants r ON e.restaurant_id = r.id;

-- 遷移 system_alerts 表數據
INSERT INTO system_alerts_new (
    id, title, description, severity, alert_type, restaurant_id, affected_component, created_at, resolved_at, resolved_by, resolution_notes, auto_resolved
) SELECT
    s.id,
    s.title,
    s.description,
    s.severity,
    s.alert_type,
    CASE
        WHEN s.restaurant_id IS NOT NULL THEN r.public_id
        ELSE NULL
    END as restaurant_id,
    s.affected_component,
    s.created_at,
    s.resolved_at,
    s.resolved_by,
    s.resolution_notes,
    s.auto_resolved
FROM system_alerts s
LEFT JOIN restaurants r ON s.restaurant_id = r.id;

-- 遷移 group_orders 表數據
INSERT INTO group_orders_new (
    id, share_code, master_order_id, created_by, restaurant_id, table_id, status, split_type, total_amount, tax_amount, service_charge, final_amount, expires_at, locked_at, completed_at, settings, notes, created_at, updated_at
) SELECT
    g.id,
    g.share_code,
    g.master_order_id,
    g.created_by,
    r.public_id as restaurant_id,
    g.table_id,
    g.status,
    g.split_type,
    g.total_amount,
    g.tax_amount,
    g.service_charge,
    g.final_amount,
    g.expires_at,
    g.locked_at,
    g.completed_at,
    g.settings,
    g.notes,
    g.created_at,
    g.updated_at
FROM group_orders g
INNER JOIN restaurants r ON g.restaurant_id = r.id;


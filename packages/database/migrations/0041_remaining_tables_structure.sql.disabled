    updated_at TEXT DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE
);

-- restaurant_special_hours 表
CREATE TABLE IF NOT EXISTS restaurant_special_hours (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    restaurant_id TEXT NOT NULL,
    special_date TEXT NOT NULL,
    special_type TEXT NOT NULL,
    description TEXT NOT NULL,
    open_time TEXT,
    close_time TEXT,
    is_closed INTEGER DEFAULT FALSE,
    is_24_hours INTEGER DEFAULT FALSE,
    break_start_time TEXT,
    break_end_time TEXT,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE
);

-- table_reservations 表
CREATE TABLE IF NOT EXISTS table_reservations (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    restaurant_id TEXT NOT NULL,
    table_id INTEGER NOT NULL,
    customer_name TEXT NOT NULL,
    customer_phone TEXT NOT NULL,
    customer_email TEXT,
    party_size INTEGER NOT NULL,
    reservation_date TEXT NOT NULL,
    reservation_time TEXT NOT NULL,
    duration_minutes INTEGER DEFAULT 120,
    status TEXT DEFAULT 'confirmed',
    special_requests TEXT,
    notes TEXT,
    confirmed_by INTEGER,
    confirmed_at TEXT,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE
);

-- leave_calendar_events 表
CREATE TABLE IF NOT EXISTS leave_calendar_events (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    event_type TEXT NOT NULL,
    name TEXT NOT NULL,
    description TEXT,
    event_date TEXT NOT NULL,
    year INTEGER NOT NULL,
    is_recurring INTEGER NOT NULL DEFAULT 0,
    restaurant_id TEXT,
    applies_to_all INTEGER NOT NULL DEFAULT 1,
    is_compensatory INTEGER NOT NULL DEFAULT 0,
    compensates_for_date TEXT,
    is_active INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE
);

-- qr_batches 表
CREATE TABLE IF NOT EXISTS qr_batches (
    batch_id TEXT PRIMARY KEY,
    qr_code_ids TEXT NOT NULL,
    options_json TEXT NOT NULL,
    generated_count INTEGER NOT NULL DEFAULT 0,
    restaurant_id TEXT,
    created_by INTEGER,
    download_url TEXT,
    download_count INTEGER DEFAULT 0,
    status TEXT DEFAULT 'completed',
    error_message TEXT,
    created_at TEXT NOT NULL DEFAULT (datetime('now')),
    completed_at TEXT,
    expires_at TEXT,
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE
);

-- qr_codes 表
CREATE TABLE IF NOT EXISTS qr_codes (
    id TEXT PRIMARY KEY,
    content TEXT NOT NULL,
    style_json TEXT NOT NULL DEFAULT '{}',
    format TEXT NOT NULL DEFAULT 'png',
    url TEXT NOT NULL,
    metadata_json TEXT DEFAULT '{}',
    table_id INTEGER,
    restaurant_id TEXT,
    created_by INTEGER,
    download_count INTEGER DEFAULT 0,
    scan_count INTEGER DEFAULT 0,
    created_at TEXT NOT NULL DEFAULT (datetime('now')),
    updated_at TEXT NOT NULL DEFAULT (datetime('now')),
    expires_at TEXT,
    is_active INTEGER DEFAULT 1,
    is_deleted INTEGER DEFAULT 0,
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE
);

-- qr_templates 表
CREATE TABLE IF NOT EXISTS qr_templates (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT,
    category TEXT NOT NULL DEFAULT 'classic',
    style_json TEXT NOT NULL,
    preview_url TEXT,
    is_public INTEGER DEFAULT 1,
    created_by INTEGER,
    restaurant_id TEXT,
    usage_count INTEGER DEFAULT 0,
    created_at TEXT NOT NULL DEFAULT (datetime('now')),
    updated_at TEXT NOT NULL DEFAULT (datetime('now')),
    is_active INTEGER DEFAULT 1,
    is_featured INTEGER DEFAULT 0,
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(public_id) ON DELETE CASCADE
);

-- 重新啟用外鍵約束
PRAGMA foreign_keys=ON;

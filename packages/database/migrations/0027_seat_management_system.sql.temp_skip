-- =====================================================
-- Migration: 座位管理系統
-- Version: 0021
-- Date: 2025-01-09
-- Description: 新增座位管理功能，支持一桌一碼和一位一碼兩種模式
-- =====================================================

-- 1. 創建 seats 表
CREATE TABLE IF NOT EXISTS seats (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    table_id INTEGER NOT NULL,
    seat_number TEXT NOT NULL,
    seat_name TEXT,
    position TEXT,

    -- QR Code 資訊
    qr_code TEXT NOT NULL UNIQUE,
    qr_code_image_url TEXT,
    qr_code_version INTEGER NOT NULL DEFAULT 1,

    -- 狀態管理
    is_occupied INTEGER NOT NULL DEFAULT 0,  -- SQLite boolean as integer
    is_active INTEGER NOT NULL DEFAULT 1,
    current_order_id INTEGER,

    -- 使用追蹤
    occupied_at INTEGER,  -- SQLite timestamp
    occupied_by TEXT,
    total_usage INTEGER NOT NULL DEFAULT 0,

    -- 時間戳
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),

    -- 外鍵約束
    FOREIGN KEY (table_id) REFERENCES tables(id) ON DELETE CASCADE,

    -- 唯一約束：同一桌子的座位編號不重複
    UNIQUE(table_id, seat_number)
);

-- 2. 為 seats 表創建索引
CREATE INDEX IF NOT EXISTS seats_table_id_idx ON seats(table_id);
CREATE INDEX IF NOT EXISTS seats_qr_code_idx ON seats(qr_code);
CREATE INDEX IF NOT EXISTS seats_table_seat_number_idx ON seats(table_id, seat_number);
CREATE INDEX IF NOT EXISTS seats_is_occupied_idx ON seats(is_occupied);
CREATE INDEX IF NOT EXISTS seats_is_active_idx ON seats(is_active);

-- 3. 修改 tables 表，新增座位管理相關欄位
-- Note: qr_mode already exists in tables from 0001_initial_schema.sql
-- ALTER TABLE tables ADD COLUMN qr_mode TEXT DEFAULT 'table'
--     CHECK (qr_mode IN ('table', 'seat'));

ALTER TABLE tables ADD COLUMN seat_count INTEGER DEFAULT 0;

ALTER TABLE tables ADD COLUMN seat_layout TEXT;  -- JSON格式

ALTER TABLE tables ADD COLUMN seat_numbering_style TEXT DEFAULT 'numeric'
    CHECK (seat_numbering_style IN ('numeric', 'alphabetic', 'custom'));

-- 4. 修改 orders 表，新增座位關聯（可選）
ALTER TABLE orders ADD COLUMN seat_id INTEGER;
ALTER TABLE orders ADD COLUMN order_source TEXT DEFAULT 'table'
    CHECK (order_source IN ('table', 'seat'));

-- 5. 創建座位訂單關聯索引
CREATE INDEX IF NOT EXISTS orders_seat_id_idx ON orders(seat_id);

-- 6. 創建 trigger：自動更新 seats 表的 updated_at
CREATE TRIGGER IF NOT EXISTS seats_updated_at
AFTER UPDATE ON seats
FOR EACH ROW
BEGIN
    UPDATE seats SET updated_at = strftime('%s', 'now') WHERE id = NEW.id;
END;

-- 7. 創建視圖：座位使用統計
CREATE VIEW IF NOT EXISTS seat_usage_stats AS
SELECT
    s.id AS seat_id,
    s.table_id,
    t.restaurant_id,
    s.seat_number,
    s.total_usage,
    s.is_occupied,
    CASE WHEN s.is_occupied = 1 THEN
        (strftime('%s', 'now') - s.occupied_at) / 60.0
    ELSE 0 END AS current_occupancy_minutes,
    t.number AS table_number,
    r.name AS restaurant_name
FROM seats s
JOIN tables t ON s.table_id = t.id
JOIN restaurants r ON t.restaurant_id = r.id
WHERE s.is_active = 1;

-- 8. 創建視圖：桌子座位摘要
CREATE VIEW IF NOT EXISTS table_seat_summary AS
SELECT
    t.id AS table_id,
    t.restaurant_id,
    t.number AS table_number,
    t.qr_mode,
    t.seat_count AS configured_seat_count,
    COUNT(s.id) AS actual_seat_count,
    SUM(CASE WHEN s.is_occupied = 1 THEN 1 ELSE 0 END) AS occupied_seats,
    SUM(CASE WHEN s.is_occupied = 0 AND s.is_active = 1 THEN 1 ELSE 0 END) AS available_seats
FROM tables t
LEFT JOIN seats s ON t.id = s.table_id
WHERE t.qr_mode = 'seat'
GROUP BY t.id;


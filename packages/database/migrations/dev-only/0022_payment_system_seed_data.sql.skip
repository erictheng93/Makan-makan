    "orderType": {"type": "string", "default": "other"},
    "locale": {"type": "string", "default": "vn", "enum": ["vn", "en"]},
    "currCode": {"type": "string", "default": "VND"},
    "timeZone": {"type": "string", "default": "+07:00"}
  }')
WHERE name = 'vnpay';


    "cancelUrl": {"type": "string", "required": true, "description": "Cancel URL"},
    "locale": {"type": "string", "default": "zh_TW", "enum": ["zh_TW", "en", "ja", "ko"]},
    "currency": {"type": "string", "default": "TWD"}
  }')
WHERE name = 'linepay';


{
  "name": "@makanmakan/database",
  "version": "1.0.0",
  "description": "Database layer with Drizzle ORM for MakanMakan",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.mjs",
      "require": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "dev": "tsup --no-clean && tsup --watch --no-clean",
    "test": "NODE_OPTIONS='--max-old-space-size=6144 --expose-gc' vitest",
    "test:run": "NODE_OPTIONS='--max-old-space-size=6144 --expose-gc' vitest run",
    "test:watch": "NODE_OPTIONS='--max-old-space-size=6144 --expose-gc' vitest --watch",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=6144 --expose-gc' vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute makanmakan-local --local --file=./migrations/0001_initial_schema.sql && wrangler d1 execute makanmakan-local --local --file=./migrations/0002_seed_data.sql && wrangler d1 execute makanmakan-local --local --file=./migrations/0003_qrcode_system.sql && wrangler d1 execute makanmakan-local --local --file=./migrations/0008_create_error_reports.sql && wrangler d1 execute makanmakan-local --local --file=./migrations/0009_additional_tables.sql",
    "db:migrate:staging": "wrangler d1 migrations apply makanmakan-staging --env staging",
    "db:migrate:prod": "wrangler d1 migrations apply makanmakan-prod --env production",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@makanmakan/queue-service": "workspace:*",
    "@makanmakan/utils": "workspace:*",
    "@paralleldrive/cuid2": "^2.2.2",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260603.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^24.3.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.6",
    "miniflare": "^3.20250718.3",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@makanmakan/queue-core": "workspace:*",
    "@makanmakan/queue-service": "workspace:*",
    "@makanmakan/shared-types": "workspace:*"
  }
}

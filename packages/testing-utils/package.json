{
  "name": "@makanmakan/testing-utils",
  "version": "1.0.0",
  "description": "Unified test data factories and testing utilities for MakanMakan platform",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./factories": "./src/factories/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@makanmakan/shared-types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^3.2.4",
    "@vitest/ui": "^3.2.4"
  },
  "keywords": [
    "testing",
    "factories",
    "test-data",
    "utilities"
  ]
}

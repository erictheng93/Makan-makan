{
  "name": "@makanmakan/i18n",
  "version": "1.0.0",
  "description": "Shared internationalization resources for MakanMakan platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./locales/*": "./src/locales/*"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "validate-translations": "node scripts/validate-translations.js",
    "generate-types": "node scripts/generate-types.js"
  },
  "dependencies": {
    "vue-i18n": "^9.14.5"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  }
}

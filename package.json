{
  "name": "makanmakan",
  "version": "2.1.0",
  "description": "智慧雲端點餐平台 - 基於Cloudflare生態系統",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --concurrency=20",
    "dev:core": "turbo run dev --filter=!@makanmakan/image-processor --filter=!@makanmakan/print-agent --concurrency=20",
    "dev:customer": "turbo run dev --filter=./apps/customer-app",
    "dev:admin": "turbo run dev --filter=./apps/admin-dashboard",
    "dev:api": "turbo run dev --filter=./apps/api",
    "dev:kitchen": "turbo run dev --filter=./apps/kitchen-display",
    "build": "turbo run build",
    "build:customer": "turbo run build --filter=./apps/customer-app",
    "build:admin": "turbo run build --filter=./apps/admin-dashboard",
    "preview": "pnpm -r run preview",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "test": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest",
    "test:unit": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run --coverage",
    "test:watch": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest --watch",
    "test:kitchen": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run apps/kitchen-display",
    "test:admin": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run apps/admin-dashboard",
    "test:api": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run apps/api",
    "test:packages": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run packages",
    "test:batch1": "pnpm test:kitchen && pnpm test:admin",
    "test:batch2": "pnpm test:api && pnpm test:packages",
    "test:all": "pnpm test:batch1 && pnpm test:batch2",
    "test:realtime": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run apps/api/src/features/realtime",
    "test:features": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run apps/api/src/features apps/admin-dashboard/src apps/kitchen-display/src apps/customer-app/src",
    "test:workers": "cross-env NODE_OPTIONS='--max-old-space-size=4096' vitest run tests/unit/workers",
    "test:integration": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run --config apps/api/vitest.integration.config.ts",
    "test:real-integration": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run --config apps/api/vitest.real-integration.config.ts",
    "test:workers:integration": "wrangler dev --test --local tests/integration/workers",
    "test:ci": "pnpm run test:unit && pnpm run test:e2e",
    "test:smoke:staging": "playwright test tests/e2e/smoke --config=playwright.staging.config.ts",
    "db:generate": "cd packages/database && npx drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply makanmakan-local --local --config=./apps/api/wrangler.toml",
    "db:migrate:staging": "wrangler d1 migrations apply makanmakan-staging --env staging --config=./apps/api/wrangler.toml",
    "db:migrate:prod": "wrangler d1 migrations apply makanmakan-prod --env production --config=./apps/api/wrangler.toml",
    "db:reset:local": "rm -rf apps/api/.wrangler/state/v3/d1/ && pnpm db:migrate:local",
    "db:seed:local": "wrangler d1 execute makanmakan-local --local --file=./scripts/seed-local.sql --config=./apps/api/wrangler.toml",
    "db:seed:staging": "wrangler d1 execute makanmakan-staging --env staging --file=./scripts/seed-staging.sql --config=./apps/api/wrangler.toml",
    "db:seed:mock": "wrangler d1 execute makanmakan-local --local --file=./scripts/seed-mock-data.sql --config=./apps/api/wrangler.toml",
    "db:backup": "npx tsx scripts/backup-database.ts",
    "db:test-migrations": "npx tsx scripts/test-migrations-v2.ts",
    "setup:secrets": "npx tsx scripts/setup-secrets.ts",
    "script": "npx tsx",
    "deploy:staging": "pnpm run build && pnpm -r run deploy:staging",
    "deploy:prod": "pnpm run build && pnpm -r run deploy:prod",
    "feature:create": "node scripts/migration/create-feature.js",
    "feature:migrate": "node scripts/migration/migrate-routes.js",
    "feature:update-imports": "node scripts/migration/update-imports.js",
    "test:qr-codes": "cd apps/api && pnpm run test -- src/features/qr-codes",
    "build:qr-codes": "cd apps/api && pnpm run build",
    "build:queue-core": "pnpm --filter @makanmakan/queue-core run build",
    "build:queue-service": "pnpm --filter @makanmakan/queue-service run build",
    "dev:queue-core": "pnpm --filter @makanmakan/queue-core run dev",
    "dev:queue-service": "pnpm --filter @makanmakan/queue-service run dev",
    "queue:typecheck": "pnpm --filter @makanmakan/queue-core run typecheck && pnpm --filter @makanmakan/queue-service run typecheck",
    "test:performance": "artillery run tests/performance/artillery-api.yml",
    "test:performance:ws": "artillery run tests/performance/artillery-websocket.yml",
    "test:performance:report": "artillery report artillery-report.json --output artillery-report.html",
    "test:load:peak": "artillery run tests/performance/artillery-lunch-peak.yml --output artillery-lunch-peak-report.json",
    "test:soak": "artillery run tests/performance/artillery-soak-test.yml --output artillery-soak-report.json",
    "test:stress": "artillery run tests/performance/artillery-stress-test.yml --output artillery-stress-report.json",
    "test:db:benchmark": "pnpm test tests/performance/db-benchmarks/query-performance.test.ts",
    "test:db:n1": "pnpm test tests/performance/db-benchmarks/n-plus-one-detection.test.ts",
    "test:db:compare": "cd tests/performance/db-benchmarks && pnpm exec tsx compare-performance.ts --fail-on-regression",
    "test:visual": "npx playwright test --config playwright.visual.config.ts",
    "test:visual:update": "npx playwright test --config playwright.visual.config.ts --update-snapshots",
    "test:security": "bash tests/security/run-zap-scan.sh",
    "test:security:snyk": "snyk test --all-projects --severity-threshold=high",
    "test:security:full": "pnpm run test:security:snyk && pnpm run test:security",
    "factory:usage": "node scripts/factory-usage-tracker.js",
    "factory:report": "node scripts/factory-usage-tracker.js && echo '\n✅ 報告已生成在 reports/factory-usage/'",
    "migration:init": "node scripts/migration-progress-tracker.js init",
    "migration:update": "node scripts/migration-progress-tracker.js update",
    "migration:report": "node scripts/migration-progress-tracker.js report",
    "migration:dashboard": "node scripts/migration-progress-tracker.js report && node scripts/factory-usage-tracker.js",
    "contract:check": "node scripts/check-api-contracts.cjs",
    "contract:update": "node scripts/check-api-contracts.cjs --update",
    "contract:report": "node scripts/check-api-contracts.cjs --report",
    "factory:check": "node scripts/check-factory-usage.cjs",
    "factory:check:ci": "OUTPUT_FORMAT=github FAIL_ON_ERROR=false node scripts/check-factory-usage.cjs",
    "factory:badges": "node scripts/factory-badge-system.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.test.ts": [
      "node scripts/check-factory-usage.cjs"
    ],
    "{apps,packages}/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --no-warn-ignored --quiet",
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,json,md,vue}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "restaurant",
    "ordering-system",
    "cloudflare",
    "serverless",
    "vue.js",
    "typescript",
    "pwa"
  ],
  "author": "MakanMakan Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.5",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "@vue/test-utils": "^2.4.6",
    "artillery": "^2.0.27",
    "better-sqlite3": "^12.6.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.6.2",
    "glob": "^13.0.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "sql.js": "^1.13.0",
    "tsx": "^4.21.0",
    "turbo": "^2.7.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.0.16",
    "vue-eslint-parser": "^10.2.0",
    "wrangler": "^4.81.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0",
      "drizzle-orm": "0.44.7",
      "better-sqlite3": "12.6.0",
      "zod": "^3.25.76",
      "uuid": "^11.0.0"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}

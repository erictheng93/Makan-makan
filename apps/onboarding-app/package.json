{
  "name": "makanmasak-onboarding-app",
  "version": "1.0.0",
  "description": "MakanMakan 獨立部署申請入口 - 新客戶開通流程",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc && vite build",
    "preview": "vite preview --host",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "deploy:staging": "wrangler pages deploy dist --project-name=makanmasak-onboarding-staging --branch=staging --commit-dirty=true",
    "deploy:prod": "wrangler pages deploy dist --project-name=makanmasak-onboarding"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.0",
    "@heroicons/vue": "^2.0.0",
    "@makanmakan/i18n": "workspace:*",
    "@tailwindcss/forms": "^0.5.0",
    "axios": "^1.17.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.27",
    "vue-router": "^4.2.0",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.2.11",
    "vue-tsc": "^3.0.6",
    "wrangler": "^4.101.0"
  }
}

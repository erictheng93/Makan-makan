{
  "name": "@makanmakan/backup-scheduler",
  "version": "1.0.0",
  "description": "Cloudflare Workers cron entry for scheduled backups (worker code lives in apps/api)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --env=\"\"",
    "build:staging": "wrangler deploy --dry-run --env staging",
    "build:prod": "wrangler deploy --dry-run --env production",
    "typecheck": "pnpm --filter @makanmakan/api typecheck",
    "lint": "pnpm --filter @makanmakan/api lint",
    "test": "pnpm run build",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env production"
  },
  "devDependencies": {
    "wrangler": "^4.98.0"
  }
}

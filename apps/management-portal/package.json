{
  "name": "@makanmakan/management-portal",
  "version": "1.0.0",
  "description": "MakanMakan 多租戶管理後台 - 管理獨立部署租戶",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc && vite build",
    "preview": "vite preview --host",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "deploy:staging": "wrangler pages deploy dist --project-name=makanmasak-management-staging --branch=staging --commit-dirty=true",
    "deploy:prod": "wrangler pages deploy dist --project-name=makanmasak-management"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.0",
    "@heroicons/vue": "^2.0.0",
    "@tailwindcss/forms": "^0.5.0",
    "@vueuse/core": "^10.7.0",
    "axios": "^1.15.2",
    "chart.js": "^4.5.0",
    "date-fns": "^3.0.0",
    "lodash-es": "^4.17.0",
    "lucide-vue-next": "^0.344.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.27",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.2.0",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.0",
    "@types/lodash-es": "^4.17.0",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/test-utils": "^2.4.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^23.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.2.11",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6",
    "wrangler": "^4.85.0"
  }
}

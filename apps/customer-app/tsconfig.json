{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "paths": {
      "@/*": ["./src/*"],
      "@makanmakan/i18n": ["../../packages/shared/src/i18n/src/index.ts"],
      "@makanmakan/i18n/locale-manager": [
        "../../packages/shared/src/i18n/src/locale-manager.ts"
      ],
      "@makanmakan/i18n/static-messages": [
        "../../packages/shared/src/i18n/src/static-messages.ts"
      ],
      "@makanmakan/i18n/types": ["../../packages/shared/src/i18n/src/types.ts"],
      "@makanmakan/shared-types": ["../../packages/shared-types/src"],
      "@makanmakan/shared-types/*": ["../../packages/shared-types/src/*"],
      "@makanmakan/utils": ["../../packages/utils/src"],
      "@makanmakan/utils/*": ["../../packages/utils/src/*"]
    }
  },
  "include": [
    "*.d.ts",
    "src/**/*",
    "*.config.*",
    "../../packages/shared-types/src/**/*",
    "../../packages/utils/src/**/*",
    "../../packages/shared/src/i18n/src/**/*"
  ],
  "exclude": ["node_modules", "dist", "src/__tests__/integration/**"]
}

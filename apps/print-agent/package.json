{
  "name": "@makanmakan/print-agent",
  "version": "2.0.0",
  "description": "Local print agent for MakanMakan restaurants",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@makanmakan/shared-types": "workspace:*",
    "@makanmakan/queue-core": "workspace:*",
    "@makanmakan/database": "workspace:*",
    "express": "^4.18.2",
    "ws": "^8.13.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@makanmakan/testing-utils": "workspace:*",
    "@types/express": "^4.17.17",
    "@types/ws": "^8.5.5",
    "@types/cors": "^2.8.13",
    "@types/node": "^20.0.0",
    "tsx": "^3.12.7",
    "typescript": "^5.1.6",
    "vitest": "^0.34.1",
    "eslint": "^8.44.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  },
  "keywords": [
    "makanmasak",
    "print",
    "agent",
    "local",
    "pos",
    "receipt"
  ],
  "author": "MakanMakan Development Team",
  "license": "MIT"
}

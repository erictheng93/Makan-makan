# Admin Dashboard — development environment template
#
# The real .env.development is committed and provides team-shared defaults.
# Copy this file to .env.development.local to override any value for your
# personal setup. .env.development.local is gitignored.
#
#   cp .env.development.example .env.development.local

# API base path — proxied by Vite to the local Worker (see vite.config.ts)
VITE_API_BASE_URL=/api/v1

# Image processor Worker base URL. Production deploys should set this to:
#   VITE_IMAGE_API_URL=https://images.makanmasak.com
# Only store the public URL here; never put image API secrets in Vite env vars.
VITE_IMAGE_API_URL=http://localhost:8790

# Management API base — used by the platform onboarding page
# (/dashboard/platform/onboarding) to reach the management-api Worker (8789).
# Leave UNSET in local dev: the code falls back to /management-api/v1, which
# Vite proxies to http://localhost:8789 (see vite.config.ts). Set this only to
# point at a non-default management-api, e.g. a deployed/staging URL:
#   VITE_MANAGEMENT_API_URL=https://management-api.example.com/api/v1
# In production builds this MUST be set to an absolute URL — prod does not run
# the Vite proxy, so the value is used directly as the request baseURL. A
# relative path like /management-api/v1 has no proxy in prod and will fail.
# VITE_MANAGEMENT_API_URL=https://management-api.example.com/api/v1

# Realtime WebSocket (Durable Objects) — port 8788
VITE_REALTIME_WS_URL=ws://localhost:8788

VITE_APP_ENV=development

# Customer app base URL — used to build group-order share links that are handed
# to diners. MUST be the customer app, not the admin dashboard: production sets
#   VITE_CUSTOMER_APP_URL=https://makanmasak.com
VITE_CUSTOMER_APP_URL=http://localhost:3000

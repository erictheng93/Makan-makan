<template>
  <div class="waiting-list-view">
    <!-- 頁面標題 -->
    <div class="page-header">
      <h1 class="page-title">{{ t('waitingList.title') }}</h1>
      <div class="header-actions">
        <el-button type="primary" @click="showAddDialog = true">
          <el-icon><Plus /></el-icon>
          {{ t('waitingList.addCustomer') }}
        </el-button>
        <el-button type="warning" @click="batchCallNext" :loading="batchCalling">
          <el-icon><Bell /></el-icon>
          {{ t('waitingList.callNext') }}
        </el-button>
      </div>
    </div>

    <!-- 統計卡片 -->
    <div class="stats-grid" v-if="queueStatus">
      <el-card class="stat-card waiting">
        <div class="stat-content">
          <div class="stat-icon"><el-icon><Clock /></el-icon></div>
          <div>
            <div class="stat-value">{{ queueStatus.waitingCount }}</div>
            <div class="stat-label">{{ t('waitingList.stats.waiting') }}</div>
          </div>
        </div>
      </el-card>
      <el-card class="stat-card called">
        <div class="stat-content">
          <div class="stat-icon"><el-icon><Bell /></el-icon></div>
          <div>
            <div class="stat-value">{{ queueStatus.calledCount }}</div>
            <div class="stat-label">{{ t('waitingList.stats.called') }}</div>
          </div>
        </div>
      </el-card>
      <el-card class="stat-card average">
        <div class="stat-content">
          <div class="stat-icon"><el-icon><Timer /></el-icon></div>
          <div>
            <div class="stat-value">{{ queueStatus.averageWaitMinutes }}min</div>
            <div class="stat-label">{{ t('waitingList.stats.avgWait') }}</div>
          </div>
        </div>
      </el-card>
      <el-card class="stat-card total">
        <div class="stat-content">
          <div class="stat-icon"><el-icon><UserFilled /></el-icon></div>
          <div>
            <div class="stat-value">{{ queueStatus.totalToday }}</div>
            <div class="stat-label">{{ t('waitingList.stats.todayTotal') }}</div>
          </div>
        </div>
      </el-card>
    </div>

    <!-- 篩選器 -->
    <el-card class="filter-card">
      <el-form :model="filters" inline>
        <el-form-item :label="t('waitingList.filter.status')">
          <el-select v-model="filters.status" :placeholder="t('waitingList.filter.allStatus')" clearable @change="loadWaitingList">
            <el-option label="等待中" value="waiting" />
            <el-option label="已叫號" value="called" />
            <el-option label="已確認" value="confirmed" />
            <el-option label="已入座" value="seated" />
            <el-option label="已取消" value="cancelled" />
            <el-option label="已過號" value="expired" />
          </el-select>
        </el-form-item>
        <el-form-item :label="t('waitingList.filter.phone')">
          <el-input
            v-model="filters.phone"
            :placeholder="t('waitingList.filter.enterPhone')"
            clearable
            @keyup.enter="loadWaitingList"
          />
        </el-form-item>
        <el-form-item>
          <el-button type="primary" @click="loadWaitingList">
            <el-icon><Search /></el-icon>
            {{ t('common.search') }}
          </el-button>
          <el-button @click="resetFilters">
            <el-icon><Refresh /></el-icon>
            {{ t('common.reset') }}
          </el-button>
          <el-button @click="loadWaitingList">
            <el-icon><Refresh /></el-icon>
            {{ t('common.refresh') }}
          </el-button>
        </el-form-item>
      </el-form>
    </el-card>

    <!-- 候位隊列 - 卡片視圖 -->
    <el-card class="queue-card">
      <template #header>
        <div class="card-header">
          <span>{{ t('waitingList.queue') }}</span>
          <el-radio-group v-model="viewMode" size="small">
            <el-radio-button label="card">{{ t('waitingList.cardView') }}</el-radio-button>
            <el-radio-button label="table">{{ t('waitingList.tableView') }}</el-radio-button>
          </el-radio-group>
        </div>
      </template>

      <!-- 卡片視圖 -->
      <div v-if="viewMode === 'card'" class="queue-grid" v-loading="loading">
        <div
          v-for="entry in waitingList"
          :key="entry.id"
          class="queue-item"
          :class="[`status-${entry.status}`, { priority: entry.priority > 0 }]"
        >
          <div class="queue-number">
            {{ formatQueueDisplay(entry) }}
          </div>
          <div class="queue-info">
            <div class="customer-name">{{ entry.customerName }}</div>
            <div class="party-info">
              <el-icon><User /></el-icon>
              {{ entry.partySize }} {{ t('waitingList.people') }}
            </div>
            <div class="wait-time" v-if="entry.estimatedWaitMinutes">
              <el-icon><Clock /></el-icon>
              {{ formatWaitTime(entry.estimatedWaitMinutes) }}
            </div>
            <div class="phone">
              <el-icon><Phone /></el-icon>
              {{ entry.customerPhone }}
            </div>
            <div class="status-tag">
              <el-tag :type="getStatusType(entry.status)" size="small">
                {{ getStatusText(entry.status) }}
              </el-tag>
            </div>
          </div>
          <div class="queue-actions">
            <el-button
              v-if="entry.status === 'waiting'"
              type="warning"
              size="small"
              @click="callCustomer(entry)"
            >
              <el-icon><Bell /></el-icon>
              {{ t('waitingList.call') }}
            </el-button>
            <el-button
              v-if="entry.status === 'called' || entry.status === 'confirmed'"
              type="success"
              size="small"
              @click="markSeated(entry.id)"
            >
              <el-icon><CircleCheck /></el-icon>
              {{ t('waitingList.seat') }}
            </el-button>
            <el-button
              v-if="entry.status === 'called'"
              type="danger"
              size="small"
              @click="markExpired(entry.id)"
            >
              <el-icon><Close /></el-icon>
              {{ t('waitingList.expire') }}
            </el-button>
            <el-button
              v-if="['waiting', 'called'].includes(entry.status)"
              type="info"
              size="small"
              plain
              @click="cancelEntry(entry)"
            >
              {{ t('waitingList.cancel') }}
            </el-button>
          </div>
        </div>
        <el-empty v-if="waitingList.length === 0" :description="t('waitingList.noQueue')" />
      </div>

      <!-- 表格視圖 -->
      <el-table v-else :data="waitingList" v-loading="loading" stripe>
        <el-table-column :label="t('waitingList.queueNumber')" width="100">
          <template #default="{ row }">
            <div class="queue-badge">{{ formatQueueDisplay(row) }}</div>
          </template>
        </el-table-column>
        <el-table-column prop="customerName" :label="t('waitingList.customerName')" width="100" />
        <el-table-column prop="customerPhone" :label="t('waitingList.customerPhone')" width="120" />
        <el-table-column prop="partySize" :label="t('waitingList.partySize')" width="80" align="center">
          <template #default="{ row }">
            {{ row.partySize }} {{ t('waitingList.people') }}
          </template>
        </el-table-column>
        <el-table-column :label="t('waitingList.waitTime')" width="100">
          <template #default="{ row }">
            {{ formatWaitTime(row.estimatedWaitMinutes) }}
          </template>
        </el-table-column>
        <el-table-column :label="t('waitingList.status')" width="100">
          <template #default="{ row }">
            <el-tag :type="getStatusType(row.status)">
              {{ getStatusText(row.status) }}
            </el-tag>
          </template>
        </el-table-column>
        <el-table-column :label="t('waitingList.joinedAt')" width="160">
          <template #default="{ row }">
            {{ formatTime(row.createdAt) }}
          </template>
        </el-table-column>
        <el-table-column :label="t('common.actions')" width="280" fixed="right">
          <template #default="{ row }">
            <el-button-group>
              <el-button
                v-if="row.status === 'waiting'"
                size="small"
                type="warning"
                @click="callCustomer(row)"
              >
                <el-icon><Bell /></el-icon>
                {{ t('waitingList.call') }}
              </el-button>
              <el-button
                v-if="row.status === 'called' || row.status === 'confirmed'"
                size="small"
                type="success"
                @click="markSeated(row.id)"
              >
                <el-icon><CircleCheck /></el-icon>
                {{ t('waitingList.seat') }}
              </el-button>
              <el-button
                v-if="row.status === 'called'"
                size="small"
                type="danger"
                @click="markExpired(row.id)"
              >
                <el-icon><Close /></el-icon>
                {{ t('waitingList.expire') }}
              </el-button>
              <el-button
                v-if="['waiting', 'called'].includes(row.status)"
                size="small"
                type="info"
                plain
                @click="cancelEntry(row)"
              >
                {{ t('waitingList.cancel') }}
              </el-button>
            </el-button-group>
          </template>
        </el-table-column>
      </el-table>

      <!-- 分頁 -->
      <div class="pagination" v-if="viewMode === 'table'">
        <el-pagination
          v-model:current-page="pagination.page"
          v-model:page-size="pagination.limit"
          :total="pagination.total"
          :page-sizes="[10, 20, 50, 100]"
          layout="total, sizes, prev, pager, next, jumper"
          @current-change="loadWaitingList"
          @size-change="loadWaitingList"
        />
      </div>
    </el-card>

    <!-- 新增候位對話框 -->
    <el-dialog v-model="showAddDialog" :title="t('waitingList.addCustomer')" width="500px">
      <el-form :model="form" label-width="120px">
        <el-form-item :label="t('waitingList.customerName')" required>
          <el-input v-model="form.customerName" />
        </el-form-item>
        <el-form-item :label="t('waitingList.customerPhone')" required>
          <el-input v-model="form.customerPhone" />
        </el-form-item>
        <el-form-item :label="t('waitingList.partySize')" required>
          <el-input-number v-model="form.partySize" :min="1" :max="20" />
        </el-form-item>
        <el-form-item :label="t('waitingList.notes')">
          <el-input
            v-model="form.notes"
            type="textarea"
            :rows="3"
            :placeholder="t('waitingList.notesPlaceholder')"
          />
        </el-form-item>
        <el-alert
          v-if="estimatedWait"
          :title="`${t('waitingList.estimatedWait')}: ${formatWaitTime(estimatedWait.estimatedWaitMinutes)}`"
          type="info"
          :closable="false"
          show-icon
        >
          <template #default>
            <div>{{ t('waitingList.partiesAhead') }}: {{ estimatedWait.partiesAhead }}</div>
            <div>{{ t('waitingList.availableTables') }}: {{ estimatedWait.availableTables }}</div>
          </template>
        </el-alert>
      </el-form>
      <template #footer>
        <el-button @click="showAddDialog = false">{{ t('common.cancel') }}</el-button>
        <el-button type="primary" @click="addToQueue" :loading="submitting">
          {{ t('common.confirm') }}
        </el-button>
      </template>
    </el-dialog>

    <!-- 叫號對話框 -->
    <el-dialog v-model="showCallDialog" :title="t('waitingList.callCustomer')" width="500px">
      <div v-if="selectedEntry" class="call-dialog-content">
        <div class="call-info">
          <div class="queue-display">{{ formatQueueDisplay(selectedEntry) }}</div>
          <div class="customer-info">
            <h3>{{ selectedEntry.customerName }}</h3>
            <p>{{ selectedEntry.customerPhone }}</p>
            <p>{{ selectedEntry.partySize }} {{ t('waitingList.people') }}</p>
          </div>
        </div>
        <el-form :model="callForm" label-width="120px">
          <el-form-item :label="t('waitingList.assignTable')" required>
            <el-select v-model="callForm.tableId" :placeholder="t('waitingList.selectTable')">
              <el-option
                v-for="table in availableTables"
                :key="table.id"
                :label="`${table.number} (${table.capacity}人)`"
                :value="table.id"
              />
            </el-select>
          </el-form-item>
          <el-form-item :label="t('waitingList.notificationMethod')">
            <el-radio-group v-model="callForm.notificationMethod">
              <el-radio label="sms">{{ t('waitingList.sms') }}</el-radio>
              <el-radio label="display">{{ t('waitingList.display') }}</el-radio>
              <el-radio label="both">{{ t('waitingList.both') }}</el-radio>
            </el-radio-group>
          </el-form-item>
        </el-form>
      </div>
      <template #footer>
        <el-button @click="showCallDialog = false">{{ t('common.cancel') }}</el-button>
        <el-button type="primary" @click="confirmCall" :loading="calling">
          <el-icon><Bell /></el-icon>
          {{ t('waitingList.confirmCall') }}
        </el-button>
      </template>
    </el-dialog>
  </div>
</template>

<script setup lang="ts">
import { ref, reactive, onMounted, computed, watch } from 'vue';
import { ElMessage, ElMessageBox } from 'element-plus';
import {
  Plus,
  Search,
  Refresh,
  Bell,
  Clock,
  Timer,
  User,
  UserFilled,
  Phone,
  CircleCheck,
  Close
} from '@element-plus/icons-vue';
import { useI18n } from 'vue-i18n';
import { useUserStore } from '@/stores/user';
import { WaitingListService } from '@/services/waitingListService';
import type {
  WaitingListEntry,
  WaitingStatus,
  JoinWaitingListRequest,
  QueueStatus,
  WaitTimeEstimateResult
} from '@makanmakan/shared-types';

const { t } = useI18n();
const userStore = useUserStore();

// 狀態
const loading = ref(false);
const submitting = ref(false);
const calling = ref(false);
const batchCalling = ref(false);
const showAddDialog = ref(false);
const showCallDialog = ref(false);
const viewMode = ref<'card' | 'table'>('card');
const waitingList = ref<WaitingListEntry[]>([]);
const queueStatus = ref<QueueStatus | null>(null);
const selectedEntry = ref<WaitingListEntry | null>(null);
const estimatedWait = ref<WaitTimeEstimateResult | null>(null);
const availableTables = ref<any[]>([]);

// 篩選器
const filters = reactive({
  status: '',
  phone: ''
});

// 分頁
const pagination = reactive({
  page: 1,
  limit: 50,
  total: 0
});

// 表單
const form = reactive<Partial<JoinWaitingListRequest>>({
  customerName: '',
  customerPhone: '',
  partySize: 2,
  notes: ''
});

// 叫號表單
const callForm = reactive({
  tableId: null as number | null,
  notificationMethod: 'both' as 'sms' | 'display' | 'both'
});

// 餐廳 ID
const restaurantId = computed(() => userStore.user?.restaurantId || '');

/**
 * 載入候位列表
 */
async function loadWaitingList() {
  loading.value = true;
  try {
    const response = await WaitingListService.listWaitingList({
      restaurantId: restaurantId.value,
      status: filters.status as WaitingStatus || undefined,
      customerPhone: filters.phone || undefined,
      page: pagination.page,
      limit: pagination.limit
    });

    if (response.success && response.data) {
      waitingList.value = response.data;
      if (response.pagination) {
        pagination.total = response.pagination.total;
      }
    }
  } catch (error) {
    console.error('Load waiting list error:', error);
    ElMessage.error(t('waitingList.loadError'));
  } finally {
    loading.value = false;
  }
}

/**
 * 載入隊列狀態
 */
async function loadQueueStatus() {
  try {
    queueStatus.value = await WaitingListService.getQueueStatus(restaurantId.value);
  } catch (error) {
    console.error('Load queue status error:', error);
  }
}

/**
 * 加入候位
 */
async function addToQueue() {
  if (!form.customerName || !form.customerPhone || !form.partySize) {
    ElMessage.warning(t('common.fillRequired'));
    return;
  }

  submitting.value = true;
  try {
    const request: JoinWaitingListRequest = {
      restaurantId: restaurantId.value,
      customerName: form.customerName,
      customerPhone: form.customerPhone,
      partySize: form.partySize,
      notes: form.notes
    };

    const response = await WaitingListService.joinWaitingList(request);
    if (response.success) {
      ElMessage.success(response.message || t('waitingList.addSuccess'));
      showAddDialog.value = false;
      resetForm();
      await loadWaitingList();
      await loadQueueStatus();
    }
  } catch (error: any) {
    console.error('Add to queue error:', error);
    ElMessage.error(error.response?.data?.error || t('waitingList.addError'));
  } finally {
    submitting.value = false;
  }
}

/**
 * 叫號
 */
function callCustomer(entry: WaitingListEntry) {
  selectedEntry.value = entry;
  callForm.tableId = null;
  // TODO: 載入可用桌位
  availableTables.value = [];
  showCallDialog.value = true;
}

/**
 * 確認叫號
 */
async function confirmCall() {
  if (!callForm.tableId) {
    ElMessage.warning(t('waitingList.selectTableRequired'));
    return;
  }

  calling.value = true;
  try {
    const response = await WaitingListService.callWaiting(selectedEntry.value!.id, {
      tableId: callForm.tableId,
      notificationMethod: callForm.notificationMethod
    });

    if (response.success) {
      ElMessage.success(response.message);
      showCallDialog.value = false;
      await loadWaitingList();
      await loadQueueStatus();
    }
  } catch (error: any) {
    console.error('Call waiting error:', error);
    ElMessage.error(error.response?.data?.error || t('waitingList.callError'));
  } finally {
    calling.value = false;
  }
}

/**
 * 批次叫號
 */
async function batchCallNext() {
  batchCalling.value = true;
  try {
    const response = await WaitingListService.batchCall(restaurantId.value, 1);
    if (response.success) {
      ElMessage.success(response.message);
      await loadWaitingList();
      await loadQueueStatus();
    }
  } catch (error: any) {
    console.error('Batch call error:', error);
    ElMessage.error(error.response?.data?.error || t('waitingList.batchCallError'));
  } finally {
    batchCalling.value = false;
  }
}

/**
 * 標記入座
 */
async function markSeated(id: string) {
  try {
    const response = await WaitingListService.markSeated(id);
    if (response.success) {
      ElMessage.success(response.message);
      await loadWaitingList();
      await loadQueueStatus();
    }
  } catch (error: any) {
    console.error('Mark seated error:', error);
    ElMessage.error(error.response?.data?.error || t('waitingList.seatedError'));
  }
}

/**
 * 標記過號
 */
async function markExpired(id: string) {
  try {
    await ElMessageBox.confirm(t('waitingList.expirePrompt'), t('common.confirm'), {
      type: 'warning'
    });

    const response = await WaitingListService.expireWaiting(id);
    if (response.success) {
      ElMessage.success(response.message);
      await loadWaitingList();
      await loadQueueStatus();
    }
  } catch (error: any) {
    if (error !== 'cancel') {
      console.error('Mark expired error:', error);
      ElMessage.error(error.response?.data?.error || t('waitingList.expireError'));
    }
  }
}

/**
 * 取消候位
 */
async function cancelEntry(entry: WaitingListEntry) {
  try {
    await ElMessageBox.confirm(t('waitingList.cancelPrompt'), t('common.confirm'), {
      type: 'warning'
    });

    const response = await WaitingListService.cancelWaiting(entry.id, entry.customerPhone);
    if (response.success) {
      ElMessage.success(response.message);
      await loadWaitingList();
      await loadQueueStatus();
    }
  } catch (error: any) {
    if (error !== 'cancel') {
      console.error('Cancel waiting error:', error);
      ElMessage.error(error.response?.data?.error || t('waitingList.cancelError'));
    }
  }
}

/**
 * 預估等待時間
 */
async function estimateWaitTime() {
  if (!form.partySize) return;

  try {
    estimatedWait.value = await WaitingListService.estimateWaitTime({
      restaurantId: restaurantId.value,
      partySize: form.partySize
    });
  } catch (error) {
    console.error('Estimate wait time error:', error);
  }
}

/**
 * 重置篩選器
 */
function resetFilters() {
  filters.status = '';
  filters.phone = '';
  pagination.page = 1;
  loadWaitingList();
}

/**
 * 重置表單
 */
function resetForm() {
  form.customerName = '';
  form.customerPhone = '';
  form.partySize = 2;
  form.notes = '';
  estimatedWait.value = null;
}

/**
 * 格式化隊列顯示
 */
function formatQueueDisplay(entry: WaitingListEntry): string {
  return WaitingListService.formatQueueDisplay(entry);
}

/**
 * 格式化等待時間
 */
function formatWaitTime(minutes?: number): string {
  return WaitingListService.formatWaitTime(minutes);
}

/**
 * 格式化時間
 */
function formatTime(timestamp: number): string {
  return new Date(timestamp).toLocaleString('zh-TW');
}

/**
 * 取得狀態文字
 */
function getStatusText(status: WaitingStatus): string {
  return WaitingListService.getStatusText(status);
}

/**
 * 取得狀態類型
 */
function getStatusType(status: WaitingStatus): string {
  return WaitingListService.getStatusColor(status) as never;
}

// 監聽表單人數變化，自動預估等待時間
watch(() => form.partySize, () => {
  if (showAddDialog.value && form.partySize) {
    estimateWaitTime();
  }
});

// 初始化
onMounted(async () => {
  await loadWaitingList();
  await loadQueueStatus();

  // 設置自動刷新（每30秒）
  setInterval(async () => {
    await loadWaitingList();
    await loadQueueStatus();
  }, 30000);
});
</script>

<style scoped lang="scss">
.waiting-list-view {
  padding: 20px;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;

  .page-title {
    font-size: 24px;
    font-weight: 600;
    margin: 0;
  }

  .header-actions {
    display: flex;
    gap: 12px;
  }
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 16px;
  margin-bottom: 20px;

  .stat-card {
    .stat-content {
      display: flex;
      align-items: center;
      gap: 16px;

      .stat-icon {
        font-size: 32px;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
      }

      .stat-value {
        font-size: 28px;
        font-weight: 600;
        margin-bottom: 4px;
      }

      .stat-label {
        font-size: 14px;
        color: var(--el-text-color-secondary);
      }
    }

    &.waiting .stat-icon {
      background: var(--el-color-info-light-9);
      color: var(--el-color-info);
    }

    &.called .stat-icon {
      background: var(--el-color-warning-light-9);
      color: var(--el-color-warning);
    }

    &.average .stat-icon {
      background: var(--el-color-primary-light-9);
      color: var(--el-color-primary);
    }

    &.total .stat-icon {
      background: var(--el-color-success-light-9);
      color: var(--el-color-success);
    }
  }
}


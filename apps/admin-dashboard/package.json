{
  "name": "makanmakan-admin-dashboard",
  "version": "1.0.0",
  "description": "MakanMakan 管理後台",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc && vite build",
    "build:analyze": "ANALYZE=true vue-tsc && vite build",
    "preview": "vite preview --host",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:real-integration": "vitest --config vitest.real-integration.config.ts",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --fix",
    "lint:fix": "eslint src --fix",
    "deploy:staging": "wrangler pages deploy dist --project-name=makanmakan-admin-staging",
    "deploy:prod": "wrangler pages deploy dist --project-name=makanmakan-admin"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.0",
    "@heroicons/vue": "^2.0.0",
    "@makanmakan/ai-analytics": "workspace:*",
    "@makanmakan/auth-client": "workspace:*",
    "@makanmakan/i18n": "workspace:*",
    "@makanmakan/shared-types": "workspace:*",
    "@stripe/stripe-js": "^4.0.0",
    "@tailwindcss/forms": "^0.5.0",
    "@vueuse/core": "^10.7.0",
    "axios": "^1.6.0",
    "chart.js": "^4.5.0",
    "date-fns": "^3.0.0",
    "jspdf": "^3.0.3",
    "lodash-es": "^4.17.0",
    "lucide-vue-next": "^0.344.0",
    "papaparse": "^5.5.3",
    "pinia": "^2.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.4.27",
    "vue-chartjs": "^5.3.2",
    "vue-draggable-plus": "^0.6.0",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.2.0",
    "vue-toastification": "^2.0.0-rc.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@makanmakan/testing-utils": "workspace:*",
    "@pinia/testing": "^0.1.0",
    "@types/lodash-es": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/papaparse": "^5.5.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "@vue/test-utils": "^2.4.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^23.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.2.11",
    "vitest": "^1.0.0",
    "vue-tsc": "^3.0.6",
    "wrangler": "^4.81.0"
  }
}

{
  "name": "@makanmakan/realtime",
  "version": "1.0.0",
  "description": "Real-time communication service using Durable Objects",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to ../../.wrangler/shared-state",
    "build": "tsc && wrangler deploy --dry-run --env=\"\"",
    "build:staging": "tsc && wrangler deploy --dry-run --env staging",
    "build:prod": "tsc && wrangler deploy --dry-run --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@makanmakan/shared-types": "workspace:*",
    "hono": "^4.12.24",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260603.1",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "4.1.9",
    "typescript": "^5.0.0",
    "vitest": "4.0.17",
    "wrangler": "^4.101.0"
  }
}

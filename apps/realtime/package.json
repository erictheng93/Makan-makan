{
  "name": "@makanmakan/realtime",
  "version": "1.0.0",
  "description": "Real-time communication service using Durable Objects",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@makanmakan/shared-types": "workspace:*",
    "hono": "^4.9.6",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20231218.0",
    "@makanmakan/testing-utils": "workspace:*",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/ws": "^8.5.10",
    "typescript": "^5.0.0",
    "wrangler": "^4.85.0"
  }
}

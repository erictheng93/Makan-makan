# Cloudflare Workers configuration
name = "makanmakan-api"
main = "src/index.ts"
compatibility_date = "2024-08-01"
compatibility_flags = ["nodejs_compat", "streams_enable_constructors"]

# PERFORMANCE OPTIMIZATION: Smart Placement for optimal routing
[placement]
mode = "smart"
strategy = "closest"

# ADVANCED ANALYTICS: Workers Analytics Engine for custom metrics
[[analytics_engine_datasets]]
binding = "ANALYTICS_ENGINE"
dataset = "makanmakan_metrics"

# SECURITY: Rate limiting KV namespace
[[kv_namespaces]]
binding = "RATE_LIMIT_KV"
id = "makanmakan-ratelimit-dev"
preview_id = "makanmakan-ratelimit-preview"

# PERFORMANCE: Cache preloading queue
[[queues.producers]]
binding = "PRELOAD_QUEUE"
queue = "makanmakan-cache-preload"

# PERFORMANCE: Cache revalidation queue
[[queues.producers]]
binding = "REVALIDATION_QUEUE"
queue = "makanmakan-cache-revalidation"

# Variables (non-sensitive only)
[vars]
NODE_ENV = "development"
API_VERSION = "v1"
API_BASE_URL = "http://localhost:8787"

# SECURITY NOTE: JWT_SECRET should be set via 'wrangler secret put JWT_SECRET'
# Never put sensitive values in wrangler.toml as they are visible in version control

# D1 Database bindings
[[d1_databases]]
binding = "DB"
database_name = "makanmakan-local"
database_id = "local"

# KV namespace for caching
[[kv_namespaces]]
binding = "CACHE_KV"
id = "makanmakan-cache-dev"
preview_id = "makanmakan-cache-preview"

# KV namespace for JWT token blacklisting (security)
[[kv_namespaces]]
binding = "TOKEN_BLACKLIST"
id = "makanmakan-tokens-dev"
preview_id = "makanmakan-tokens-preview"

# R2 bucket for file storage
[[r2_buckets]]
binding = "IMAGES_BUCKET"
bucket_name = "makanmakan-images"

# Durable Objects for real-time features
[[durable_objects.bindings]]
name = "REALTIME_ORDERS"
class_name = "RealtimeOrders"

# Queue for background jobs
[[queues.producers]]
binding = "JOB_QUEUE"
queue = "makanmakan-jobs"

# Staging environment with advanced configuration
[env.staging]
name = "makanmakan-api-staging"
vars = {
  NODE_ENV = "staging", 
  API_VERSION = "v1", 
  API_BASE_URL = "https://api-staging.makanmakan.com",
  PREFERRED_REGION = "asia-southeast1",
  CACHE_TTL_DEFAULT = "300",
  CACHE_TTL_MENU = "600",
  RATE_LIMIT_MULTIPLIER = "1.5"
}

# Smart Placement for staging
[env.staging.placement]
mode = "smart"
strategy = "closest"
hints = ["asia-southeast1"]

# Analytics Engine for staging
[[env.staging.analytics_engine_datasets]]
binding = "ANALYTICS_ENGINE"
dataset = "makanmakan_metrics_staging"

# Rate limiting KV for staging
[[env.staging.kv_namespaces]]
binding = "RATE_LIMIT_KV"
id = "makanmakan-ratelimit-staging"

[[env.staging.d1_databases]]
binding = "DB"
database_name = "makanmakan-staging"
# SECURITY NOTE: Replace with actual D1 database ID from Cloudflare dashboard
# Run: wrangler d1 create makanmakan-staging
# Then update this ID with the returned database_id
database_id = "YOUR_STAGING_DATABASE_ID_HERE"

[[env.staging.kv_namespaces]]
binding = "CACHE_KV"
id = "makanmakan-cache-staging"

[[env.staging.kv_namespaces]]
binding = "TOKEN_BLACKLIST"
id = "makanmakan-tokens-staging"

# Production environment with enterprise optimizations
[env.production]
name = "makanmakan-api-prod"
vars = {
  NODE_ENV = "production", 
  API_VERSION = "v1", 
  API_BASE_URL = "https://api.makanmakan.com",
  PREFERRED_REGION = "asia-southeast1",
  CACHE_TTL_DEFAULT = "600",
  CACHE_TTL_MENU = "1800",
  CACHE_TTL_ANALYTICS = "300",
  RATE_LIMIT_MULTIPLIER = "1.0",
  SECURITY_THREAT_THRESHOLD = "50",
  PRELOAD_POPULAR_QUERIES = "true"
}

# Production Smart Placement with multi-region hints
[env.production.placement]
mode = "smart"
strategy = "closest"
hints = ["asia-southeast1", "europe-west1", "us-west2"]
fallback_origin = "asia-southeast1"

# Production Analytics Engine
[[env.production.analytics_engine_datasets]]
binding = "ANALYTICS_ENGINE"
dataset = "makanmakan_metrics_production"

# Production Rate limiting
[[env.production.kv_namespaces]]
binding = "RATE_LIMIT_KV"
id = "makanmakan-ratelimit-prod"

# Production Cache preloading
[[env.production.queues.producers]]
binding = "PRELOAD_QUEUE"
queue = "makanmakan-cache-preload-prod"

[[env.production.queues.producers]]
binding = "REVALIDATION_QUEUE"
queue = "makanmakan-cache-revalidation-prod"

[[env.production.d1_databases]]
binding = "DB"
database_name = "makanmakan-prod"
# SECURITY NOTE: Replace with actual D1 database ID from Cloudflare dashboard
# Run: wrangler d1 create makanmakan-prod
# Then update this ID with the returned database_id
database_id = "YOUR_PRODUCTION_DATABASE_ID_HERE"

[[env.production.kv_namespaces]]
binding = "CACHE_KV"
id = "makanmakan-cache-prod"

[[env.production.kv_namespaces]]
binding = "TOKEN_BLACKLIST"
id = "makanmakan-tokens-prod"

# Build configuration
[build]
command = "pnpm run build"

# Advanced performance and security limits
[limits]
cpu_ms = 1000
memory_mb = 128

# SECURITY: Advanced observability and monitoring
[observability]
logs_enabled = true
metrics_enabled = true
traces_enabled = true

# PERFORMANCE: Build optimizations
[build]
command = "pnpm run build"
watch_dir = ["src"]

# SECURITY: WAF-style rules (configured via Cloudflare Dashboard)
# Note: These would typically be configured via the Cloudflare Dashboard
# but documented here for reference:
#
# WAF Rules to implement:
# 1. Block requests with threat score > 50
# 2. Challenge admin access from non-trusted countries  
# 3. Rate limit aggressive patterns (>100 req/min from single IP)
# 4. Block known attack patterns in URLs
# 5. Geo-restrict admin endpoints to specific countries
#
# Rate Limiting Rules:
# 1. 100 req/min per IP for general endpoints
# 2. 10 req/min per IP for auth endpoints
# 3. 500 req/min per restaurant for business endpoints
# 4. Dynamic limits based on threat score and geography

# COMPATIBILITY: Latest compatibility date for newest features
compatibility_date = "2024-12-01"

# DEPLOYMENT: Advanced deployment configuration
[triggers]
crons = [
  "0 */5 * * * *",  # Cache health check every 5 minutes
  "0 0 * * * *",   # Daily cleanup job
  "0 */15 * * * *"  # Preload popular queries every 15 minutes
]
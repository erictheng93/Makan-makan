import crypto from 'crypto'
import {
  PaymentProvider,
  PaymentRequest,
  PaymentResult,
  RefundRequest,
  RefundResult,
  WebhookResult,
  PaymentStatus,
  CountryCode,
  PaymentProviderConfig
} from '@makanmakan/shared-types'

interface VNPayConfig {
  tmnCode: string
  hashSecret: string
  paymentUrl: string
  returnUrl: string
  ipnUrl: string
  version: string
  command: string
  orderType: string
  locale: string
  currCode: string
  timeZone: string
}

// eslint-disable-next-line @typescript-eslint/no-unused-vars
interface VNPayResponse {
  vnp_Amount: string
  vnp_BankCode: string
  vnp_BankTranNo: string
  vnp_CardType: string
  vnp_OrderInfo: string
  vnp_PayDate: string
  vnp_ResponseCode: string
  vnp_TmnCode: string
  vnp_TransactionNo: string
  vnp_TransactionStatus: string
  vnp_TxnRef: string
  vnp_SecureHashType: string
  vnp_SecureHash: string
}

export class VNPayProvider extends PaymentProvider {
  readonly name = 'vnpay'
  readonly displayName = 'VNPay'
  readonly supportedCountries: CountryCode[] = ['VN']
  readonly supportedMethods: PaymentMethod[] = ['bank_transfer', 'momo', 'viet_qr', 'vnpay']

  private vnpayConfig: VNPayConfig

  constructor(config: PaymentProviderConfig & { vnpayConfig: VNPayConfig }) {
    super(config)
    this.vnpayConfig = config.vnpayConfig
  }

  async createPayment(request: PaymentRequest): Promise<PaymentResult> {
    try {
      // 驗證國家和貨幣
      if (request.country !== 'VN' || request.currency !== 'VND') {
        throw new Error('VNPay only supports Vietnam (VN) and VND currency')
      }

      // 生成交易參考號
      const txnRef = this.generateTxnRef(request.orderId)
      const createDate = this.formatDate(new Date())
      const expireDate = this.formatDate(new Date(Date.now() + 15 * 60 * 1000)) // 15分鐘後過期
      
      // 準備 VNPay 參數
      const vnpayParams: Record<string, string> = {
        vnp_Version: this.vnpayConfig.version,
        vnp_Command: this.vnpayConfig.command,
        vnp_TmnCode: this.vnpayConfig.tmnCode,
        vnp_Amount: Math.round(request.amount * 100).toString(), // VNPay 金額以分為單位
        vnp_CurrCode: this.vnpayConfig.currCode,
        vnp_TxnRef: txnRef,
        vnp_OrderInfo: `Order ${request.orderId} - Restaurant ${request.restaurantId}`,
        vnp_OrderType: this.vnpayConfig.orderType,
        vnp_Locale: this.vnpayConfig.locale,
        vnp_ReturnUrl: request.returnUrl || this.vnpayConfig.returnUrl,
        vnp_IpnUrl: this.vnpayConfig.ipnUrl,
        vnp_CreateDate: createDate,
        vnp_ExpireDate: expireDate,
        vnp_IpAddr: '127.0.0.1' // 在實際環境中應該是真實 IP
      }

      // 根據支付方式設置銀行代碼
      const bankCode = this.mapPaymentMethodToBankCode(request.method)
      if (bankCode) {
        vnpayParams.vnp_BankCode = bankCode
      }

      // 生成安全雜湊
      const secureHash = this.generateSecureHash(vnpayParams)
      
      // 構建支付 URL
      const paymentUrl = this.buildPaymentUrl(vnpayParams, secureHash)

      return {
        success: true,
        transactionId: txnRef,
        status: 'pending',
        redirectUrl: paymentUrl,
        metadata: {
          vnpayParams,
          provider: 'vnpay'
        }
      }

    } catch (error) {
      console.error('VNPay payment creation failed:', error)
      return {
        success: false,
        transactionId: '',
        status: 'failed',
        error: {
          code: 'VNPAY_ERROR',
          message: (error as Error).message
        }
      }
    }
  }

  async getPaymentStatus(transactionId: string): Promise<PaymentStatus> {
    try {
      // VNPay 查詢 API 參數
      const queryDate = this.formatDate(new Date())
      const queryParams: Record<string, string> = {
        vnp_Version: this.vnpayConfig.version,
        vnp_Command: 'querydr',
        vnp_TmnCode: this.vnpayConfig.tmnCode,
        vnp_TxnRef: transactionId,
        vnp_OrderInfo: `Query ${transactionId}`,
        vnp_TransactionDate: queryDate,
        vnp_CreateDate: queryDate,
        vnp_IpAddr: '127.0.0.1'
      }

      const secureHash = this.generateSecureHash(queryParams)
      const queryUrl = this.buildQueryUrl(queryParams, secureHash)

      // 發送查詢請求到 VNPay
      const response = await fetch(queryUrl, {
        method: 'GET'
      })

      const result = await response.text()
      
      // 解析查詢結果
      const params = new URLSearchParams(result)
      const responseCode = params.get('vnp_ResponseCode')
      const transactionStatus = params.get('vnp_TransactionStatus')

      // 根據回應碼判斷狀態
      if (responseCode === '00' && transactionStatus === '00') {
        return 'completed'
      } else if (responseCode === '00' && transactionStatus === '01') {
        return 'pending'
      } else {
        return 'failed'
      }

    } catch (error) {
      console.error('Failed to query VNPay payment status:', error)
      return 'pending'
    }
  }

  async refundPayment(request: RefundRequest): Promise<RefundResult> {
    try {
      const refundDate = this.formatDate(new Date())
      const refundParams: Record<string, string> = {
        vnp_Version: this.vnpayConfig.version,
        vnp_Command: 'refund',
        vnp_TmnCode: this.vnpayConfig.tmnCode,
        vnp_TransactionType: '02', // 全額退款
        vnp_TxnRef: request.transactionId,
        vnp_Amount: Math.round((request.amount || 0) * 100).toString(),
        vnp_OrderInfo: `Refund for ${request.transactionId}`,
        vnp_TransactionNo: '', // 需要原始交易號
        vnp_TransactionDate: refundDate,
        vnp_CreateDate: refundDate,
        vnp_CreateBy: 'System',
        vnp_IpAddr: '127.0.0.1'
      }

      const secureHash = this.generateSecureHash(refundParams)
      const refundUrl = this.buildRefundUrl(refundParams, secureHash)

      // 發送退款請求
      const response = await fetch(refundUrl, {
        method: 'GET'
      })

      const result = await response.text()
      const params = new URLSearchParams(result)
      const responseCode = params.get('vnp_ResponseCode')
      const transactionStatus = params.get('vnp_TransactionStatus')

      if (responseCode === '00') {
        return {
          success: true,
          refundId: params.get('vnp_TxnRef') || '',
          amount: request.amount || 0,
          status: transactionStatus === '00' ? 'completed' : 'pending'
        }
      }

      return {
        success: false,
        refundId: '',
        amount: request.amount || 0,
        status: 'failed',
        error: {
          code: 'REFUND_FAILED',
          message: `VNPay refund failed with code: ${responseCode}`
        }
      }

    } catch (error) {
      console.error('VNPay refund failed:', error)
      return {
        success: false,
        refundId: '',
        amount: request.amount || 0,
        status: 'failed',
        error: {
          code: 'REFUND_ERROR',
          message: (error as Error).message
        }
      }
    }
  }

  async handleWebhook(payload: any, _signature?: string): Promise<WebhookResult> {
    try {
      // VNPay IPN (即時支付通知) 處理
      const params = typeof payload === 'string' 
        ? new URLSearchParams(payload)
        : new URLSearchParams(Object.entries(payload).map(([k, v]) => [k, String(v)]))

      const receivedHash = params.get('vnp_SecureHash')
      if (!receivedHash) {
        throw new Error('Missing vnp_SecureHash in VNPay notification')
      }

      // 移除 hash 相關參數後重新計算
      const paramsForHash: Record<string, string> = {}
      params.forEach((value, key) => {
        if (!key.startsWith('vnp_SecureHash')) {
          paramsForHash[key] = value
        }
      })

      // 驗證安全雜湊
      const expectedHash = this.generateSecureHash(paramsForHash)
      if (receivedHash !== expectedHash) {
        throw new Error('Invalid vnp_SecureHash in VNPay notification')
      }

      // 解析支付結果
      const responseCode = params.get('vnp_ResponseCode')
      const transactionStatus = params.get('vnp_TransactionStatus')
      const txnRef = params.get('vnp_TxnRef')
      const amount = params.get('vnp_Amount')
      const payDate = params.get('vnp_PayDate')

      let newStatus: PaymentStatus = 'pending'
      if (responseCode === '00' && transactionStatus === '00') {
        newStatus = 'completed'
      } else if (responseCode === '00' && transactionStatus === '01') {
        newStatus = 'pending'
      } else {
        newStatus = 'failed'
      }

      return {
        processed: true,
        transactionId: txnRef || '',
        newStatus,
        shouldUpdateOrder: newStatus === 'completed',
        metadata: {
          vnpayTransactionNo: params.get('vnp_TransactionNo'),
          bankCode: params.get('vnp_BankCode'),
          bankTranNo: params.get('vnp_BankTranNo'),
          cardType: params.get('vnp_CardType'),
          payDate: payDate,
          amount: amount ? (parseInt(amount) / 100).toString() : '0'
        }
      }

    } catch (error) {
      console.error('VNPay webhook processing error:', error)
      return {
        processed: false,
        error: (error as Error).message
      }
    }
  }

  validateConfig(): boolean {
    try {
      const required = ['tmnCode', 'hashSecret', 'paymentUrl', 'returnUrl', 'ipnUrl']
      for (const key of required) {
        if (!this.vnpayConfig[key as keyof VNPayConfig]) {
          console.error(`Missing required VNPay config: ${key}`)
          return false
        }
      }

      // 檢查商家代碼格式
      if (!/^[A-Z0-9]{8}$/.test(this.vnpayConfig.tmnCode)) {
        console.error('Invalid VNPay TMN Code format (should be 8 characters)')
        return false
      }

      return true
    } catch (error) {
      console.error('VNPay config validation error:', error)
      return false
    }
  }

  // =============================================
  // 私有方法
  // =============================================

  private generateTxnRef(orderId: string): string {
    // VNPay 交易參考號：數字，最長100字符
    const timestamp = Date.now().toString()
    const randomStr = Math.floor(Math.random() * 1000000).toString().padStart(6, '0')
    return `${orderId}${timestamp}${randomStr}`
  }

  private formatDate(date: Date): string {
    // VNPay 日期格式：yyyyMMddHHmmss
    const year = date.getFullYear()
    const month = String(date.getMonth() + 1).padStart(2, '0')
    const day = String(date.getDate()).padStart(2, '0')
    const hours = String(date.getHours()).padStart(2, '0')
    const minutes = String(date.getMinutes()).padStart(2, '0')
    const seconds = String(date.getSeconds()).padStart(2, '0')
    
    return `${year}${month}${day}${hours}${minutes}${seconds}`
  }

  private mapPaymentMethodToBankCode(method: string): string | null {
    // VNPay 銀行代碼對應
    const bankCodeMap: Record<string, string> = {
      'momo': 'MOMO',
      'viet_qr': 'VIETQR',
      'bank_transfer': 'VNBANK',
      'vnpay': '' // 不指定銀行代碼，顯示所有選項
    }
    
    return bankCodeMap[method] || null
  }

  private generateSecureHash(params: Record<string, string>): string {
    // 1. 按照參數名稱字母順序排序
    const sortedKeys = Object.keys(params)
      .filter(key => params[key] !== '' && params[key] !== null && params[key] !== undefined)
      .sort()
    
    // 2. 組成查詢字串
    const queryString = sortedKeys
      .map(key => `${key}=${encodeURIComponent(params[key])}`)
      .join('&')
    
    // 3. 加上密鑰並計算 HMAC SHA512
    const hmac = crypto.createHmac('sha512', this.vnpayConfig.hashSecret)
    hmac.update(queryString, 'utf8')
    
    return hmac.digest('hex').toUpperCase()
  }

  private buildPaymentUrl(params: Record<string, string>, secureHash: string): string {
    const sortedKeys = Object.keys(params).sort()
    const queryString = sortedKeys
      .map(key => `${key}=${encodeURIComponent(params[key])}`)
      .join('&')
    
    return `${this.vnpayConfig.paymentUrl}?${queryString}&vnp_SecureHash=${secureHash}`
  }

  private buildQueryUrl(params: Record<string, string>, secureHash: string): string {
    const sortedKeys = Object.keys(params).sort()
    const queryString = sortedKeys
      .map(key => `${key}=${encodeURIComponent(params[key])}`)
      .join('&')
    
    const queryEndpoint = this.vnpayConfig.paymentUrl.replace('/paymentv2/vpcpay.html', '/merchant_webapi/api/transaction')
    return `${queryEndpoint}?${queryString}&vnp_SecureHash=${secureHash}`
  }

  private buildRefundUrl(params: Record<string, string>, secureHash: string): string {
    const sortedKeys = Object.keys(params).sort()
    const queryString = sortedKeys
      .map(key => `${key}=${encodeURIComponent(params[key])}`)
      .join('&')
    
    const refundEndpoint = this.vnpayConfig.paymentUrl.replace('/paymentv2/vpcpay.html', '/merchant_webapi/api/transaction')
    return `${refundEndpoint}?${queryString}&vnp_SecureHash=${secureHash}`
  }
}
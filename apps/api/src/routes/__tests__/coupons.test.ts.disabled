import { describe, it, expect, beforeEach, vi } from 'vitest'
import { Hono } from 'hono'
import couponsRouter from '../coupons'

// Mock CouponService
const mockCouponService = {
  validateCoupon: vi.fn(),
  getAvailableCoupons: vi.fn(),
  createCoupon: vi.fn(),
  getCoupons: vi.fn(),
  getCoupon: vi.fn(),
  updateCoupon: vi.fn(),
  deactivateCoupon: vi.fn(),
  deleteCoupon: vi.fn(),
  getCouponStats: vi.fn(),
}

// Mock database
vi.mock('@makanmasak/database', () => ({
  createDatabase: vi.fn(),
  CouponService: vi.fn().mockImplementation(() => mockCouponService),
}))

// Mock middleware
vi.mock('../middleware/auth', () => ({
  authMiddleware: vi.fn((c, next) => {
    c.set('user', { id: 1, role: 1, restaurantId: '1' })
    return next()
  }),
  requireRole: vi.fn(() => (c: any, next: any) => next()),
}))

vi.mock('../middleware/validation', () => ({
  validateBody: vi.fn(() => (c: any, next: any) => {
    c.set('validatedBody', c.get('testBody'))
    return next()
  }),
  validateQuery: vi.fn(() => (c: any, next: any) => {
    c.set('validatedQuery', c.get('testQuery'))
    return next()
  }),
  validateParams: vi.fn(() => (c: any, next: any) => {
    c.set('validatedParams', c.get('testParams'))
    return next()
  }),
  commonSchemas: {
    idParam: {}
  }
}))

describe('Coupons API Routes', () => {
  let app: Hono

  beforeEach(() => {
    vi.clearAllMocks()
    app = new Hono()
    app.route('/coupons', couponsRouter)
  })

  describe('POST /coupons/validate', () => {
    it('should validate coupon successfully', async () => {
      const validationResult = {
        valid: true,
        coupon: { id: 1, code: 'VALID10' },
        discountAmount: 10,
        finalAmount: 90,
      }

      mockCouponService.validateCoupon.mockResolvedValue(validationResult)

      const req = new Request('http://localhost/coupons/validate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          code: 'VALID10',
          restaurantId: '1',
          orderAmount: 100,
        })
      })

      const testApp = new Hono()
      testApp.use('*', async (c, next) => {
        c.env = { DB: {} }
        return next()
      })
      testApp.route('/', couponsRouter)

      const res = await testApp.request('/validate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          code: 'VALID10',
          restaurantId: '1',
          orderAmount: 100,
        })
      })

      expect(res.status).toBe(200)
      const data: any = await res.json()
      expect(data.success).toBe(true)
      expect(data.data).toEqual(validationResult)
    })

    it('should return validation error for invalid coupon', async () => {
      const validationResult = {
        valid: false,
        error: '優惠券代碼不存在或已失效',
      }

      mockCouponService.validateCoupon.mockResolvedValue(validationResult)

      const testApp = new Hono()
      testApp.use('*', async (c, next) => {
        c.env = { DB: {} }
        return next()
      })
      testApp.route('/', couponsRouter)

      const res = await testApp.request('/validate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          code: 'INVALID',
          restaurantId: '1',
          orderAmount: 100,
        })
      })

      expect(res.status).toBe(200)
      const data: any = await res.json()
      expect(data.success).toBe(true)
      expect(data.data.valid).toBe(false)
      expect(data.data.error).toContain('不存在')
    })
  })

  describe('GET /coupons/available/:restaurantId', () => {
    it('should return available coupons', async () => {
      const availableCoupons = [
        { id: 1, code: 'WELCOME10', name: 'Welcome Discount' },
        { id: 2, code: 'SAVE20', name: 'Save 20' },
      ]

      mockCouponService.getAvailableCoupons.mockResolvedValue(availableCoupons)

      const testApp = new Hono()
      testApp.use('*', async (c, next) => {
        c.env = { DB: {} }
        return next()
      })
      testApp.route('/', couponsRouter)

      const res = await testApp.request('/available/1')

      expect(res.status).toBe(200)
      const data: any = await res.json()
      expect(data.success).toBe(true)
      expect(data.data).toEqual(availableCoupons)
    })
  })

  describe('POST /coupons', () => {
    it('should create coupon successfully', async () => {
      const couponData = {
        code: 'NEWCOUPON',
        name: 'New Coupon',
        discountType: 'percentage',
        discountValue: 15,
        validFrom: '2025-01-01T00:00:00Z',
        validTo: '2025-12-31T23:59:59Z',
      }

      const createdCoupon = { id: 1, ...couponData }

      mockCouponService.createCoupon.mockResolvedValue(createdCoupon)

      const testApp = new Hono()
      testApp.use('*', (c, next) => {
        c.set('testBody', couponData)
        c.set('user', { id: 1, role: 1, restaurantId: '1' })
        c.env = { DB: {} }
        return next()
      })
      testApp.route('/', couponsRouter)

      const res = await testApp.request('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(couponData)
      })

      expect(res.status).toBe(201)
      const data: any = await res.json()
      expect(data.success).toBe(true)
      expect(data.data).toEqual(createdCoupon)
    })
  })

  describe('GET /coupons', () => {
    it('should return paginated coupons list', async () => {
      const couponsResult = {
        coupons: [
          { id: 1, code: 'COUPON1', name: 'Coupon 1' },
          { id: 2, code: 'COUPON2', name: 'Coupon 2' },
        ],
        total: 2,
        page: 1,
        limit: 20,
      }

      mockCouponService.getCoupons.mockResolvedValue(couponsResult)

      const testApp = new Hono()
      testApp.use('*', (c, next) => {
        c.set('testQuery', { page: '1', limit: '20' })
        c.set('user', { id: 1, role: 1, restaurantId: '1' })
        c.env = { DB: {} }
        return next()
      })
      testApp.route('/', couponsRouter)

      const res = await testApp.request('/')

      expect(res.status).toBe(200)
      const data: any = await res.json()
      expect(data.success).toBe(true)
      expect(data.data).toEqual(couponsResult.coupons)
      expect(data.pagination).toEqual({
        total: 2,
        page: 1,
        limit: 20,
        pages: 1,
      })
    })
  })

  describe('GET /coupons/:id', () => {
    it('should return coupon details', async () => {
      const coupon = {
        id: 1,
        code: 'TESTCOUPON',
        name: 'Test Coupon',
        restaurantId: '1',
      }

      mockCouponService.getCoupon.mockResolvedValue(coupon)

      const testApp = new Hono()
      testApp.use('*', (c, next) => {
        c.set('testParams', { id: '1' })
        c.set('user', { id: 1, role: 1, restaurantId: '1' })
        c.env = { DB: {} }
        return next()
      })
      testApp.route('/', couponsRouter)

      const res = await testApp.request('/1')

      expect(res.status).toBe(200)
      const data: any = await res.json()
      expect(data.success).toBe(true)
      expect(data.data).toEqual(coupon)
    })

    it('should return 404 for non-existent coupon', async () => {
      mockCouponService.getCoupon.mockResolvedValue(null)

      const testApp = new Hono()
      testApp.use('*', (c, next) => {
        c.set('testParams', { id: '999' })
        c.set('user', { id: 1, role: 1, restaurantId: '1' })
        c.env = { DB: {} }
        return next()
      })
      testApp.route('/', couponsRouter)

      const res = await testApp.request('/999')

      expect(res.status).toBe(404)
      const data: any = await res.json()
      expect(data.success).toBe(false)
      expect(data.error).toBe('Coupon not found')
    })
  })

  describe('PUT /coupons/:id', () => {
    it('should update coupon successfully', async () => {
      const existingCoupon = {
        id: 1,
        code: 'TESTCOUPON',
        restaurantId: '1',
      }

      const updateData = {
        name: 'Updated Coupon Name',
      }

      const updatedCoupon = { ...existingCoupon, ...updateData }

      mockCouponService.getCoupon.mockResolvedValue(existingCoupon)
      mockCouponService.updateCoupon.mockResolvedValue(updatedCoupon)

      const testApp = new Hono()
      testApp.use('*', (c, next) => {
        c.set('testParams', { id: '1' })
        c.set('testBody', updateData)
        c.set('user', { id: 1, role: 1, restaurantId: '1' })
        c.env = { DB: {} }
        return next()
      })
      testApp.route('/', couponsRouter)

      const res = await testApp.request('/1', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(updateData)
      })

      expect(res.status).toBe(200)
      const data: any = await res.json()
      expect(data.success).toBe(true)
      expect(data.data).toEqual(updatedCoupon)
    })
  })

  describe('POST /coupons/:id/deactivate', () => {
    it('should deactivate coupon successfully', async () => {
      const coupon = {
        id: 1,
        code: 'TESTCOUPON',
        restaurantId: '1',
        isActive: true,
      }

      const deactivatedCoupon = { ...coupon, isActive: false }

      mockCouponService.getCoupon.mockResolvedValue(coupon)
      mockCouponService.deactivateCoupon.mockResolvedValue(deactivatedCoupon)

      const testApp = new Hono()
      testApp.use('*', (c, next) => {
        c.set('testParams', { id: '1' })
        c.set('user', { id: 1, role: 1, restaurantId: '1' })
        c.env = { DB: {} }
        return next()
      })
      testApp.route('/', couponsRouter)

      const res = await testApp.request('/1/deactivate', {
        method: 'POST'
      })

      expect(res.status).toBe(200)
      const data: any = await res.json()
      expect(data.success).toBe(true)
      expect(data.message).toBe('Coupon deactivated successfully')
    })
  })

  describe('DELETE /coupons/:id', () => {
    it('should delete coupon successfully (admin only)', async () => {
      const coupon = {
        id: 1,
        code: 'TESTCOUPON',
        restaurantId: '1',
      }

      mockCouponService.getCoupon.mockResolvedValue(coupon)
      mockCouponService.deleteCoupon.mockResolvedValue(undefined)

      const testApp = new Hono()
      testApp.use('*', (c, next) => {
        c.set('testParams', { id: '1' })
        c.set('user', { id: 1, role: 0, restaurantId: '1' }) // Admin role
        c.env = { DB: {} }
        return next()
      })
      testApp.route('/', couponsRouter)

      const res = await testApp.request('/1', {
        method: 'DELETE'
      })

      expect(res.status).toBe(200)
      const data: any = await res.json()
      expect(data.success).toBe(true)
      expect(data.message).toBe('Coupon deleted successfully')
    })
  })

  describe('GET /coupons/:id/stats', () => {
    it('should return coupon usage statistics', async () => {
      const coupon = {
        id: 1,
        code: 'TESTCOUPON',
        name: 'Test Coupon',
        discountType: 'percentage',
        discountValue: 10,
        restaurantId: '1',
      }

      const stats = {
        totalUsed: 15,
        totalDiscount: 150.5,
        avgDiscount: 10.03,
        lastUsed: '2025-01-15T10:30:00Z',
      }

      mockCouponService.getCoupon.mockResolvedValue(coupon)
      mockCouponService.getCouponStats.mockResolvedValue(stats)

      const testApp = new Hono()
      testApp.use('*', (c, next) => {
        c.set('testParams', { id: '1' })
        c.set('user', { id: 1, role: 1, restaurantId: '1' })
        c.env = { DB: {} }
        return next()
      })
      testApp.route('/', couponsRouter)

      const res = await testApp.request('/1/stats')

      expect(res.status).toBe(200)
      const data: any = await res.json()
      expect(data.success).toBe(true)
      expect(data.data.coupon.id).toBe(1)
      expect(data.data.stats).toEqual(stats)
    })
  })
})
/* eslint-disable @typescript-eslint/no-unused-vars */
/**
 * 支付系統使用範例和整合指南
 * 
 * 這個檔案展示如何使用新建的支付基礎架構
 */

import { PaymentService } from '../services/PaymentService'
import { PaymentOrchestrator } from '../services/PaymentOrchestrator'
import { PaymentConfigManager } from '../services/PaymentConfigManager'
import {
  PaymentRequest,
  PaymentResult,
  RefundRequest,
  CountryCode,
  PaymentMethod
} from '@makanmakan/shared-types'

// =============================================
// 1. 基本支付流程範例
// =============================================

/**
 * 基本支付處理範例
 * 展示如何建立支付請求、處理支付和檢查狀態
 */
async function basicPaymentExample() {
  // 初始化支付服務
  const paymentService = new PaymentService({ database: {} })
  
  // 建立支付請求
  const paymentRequest: PaymentRequest = {
    orderId: 'ORD-20231125-001',
    restaurantId: 1,
    amount: 12500, // $125.00
    currency: 'TWD',
    country: 'TW',
    method: 'credit_card',
    customerInfo: {
      email: 'customer@example.com',
      name: '王小明'
    }
    // description: '線上餐廳訂單 #ORD-20231125-001'
  }
  
  try {
    // 處理支付
    const result = await paymentService.createPayment(paymentRequest)
    
    if (result.success) {
      console.log('支付成功!', {
        transactionId: result.transactionId,
        status: result.status
      })
      
      // 更新訂單狀態為已付款
      await updateOrderStatus(paymentRequest.orderId, 'paid')
      
    } else {
      console.error('支付失敗:', result.error)
      
      // 記錄失敗原因並通知客戶
      await logPaymentFailure(paymentRequest.orderId, result.error)
    }
    
  } catch (error) {
    console.error('支付處理異常:', error)
    throw error
  }
}

// =============================================
// 2. 多國家支付配置範例
// =============================================

/**
 * 多國家支付配置範例
 * 展示如何為不同國家配置支付提供商
 */
async function multiCountryPaymentExample() {
  const configManager = new PaymentConfigManager({} as any)
  
  // 台灣：ECPay + LINE Pay
  await configManager.setCountryConfig({
    country: 'TW',
    currency: 'TWD',
    primaryProvider: 'ecpay',
    fallbackProviders: ['stripe'],
    supportedMethods: ['credit_card', 'debit_card', 'bank_transfer', 'digital_wallet'],
    minimumAmount: 100,
    maximumAmount: 100000,
    taxRate: 0.05,
    processingFeeRate: 0.03
  })
  
  // 馬來西亞：iPay88 + Stripe
  await configManager.setCountryConfig({
    country: 'MY',
    currency: 'MYR',
    primaryProvider: 'ipay88',
    fallbackProviders: ['stripe'],
    supportedMethods: ['credit_card', 'digital_wallet', 'bank_transfer'],
    minimumAmount: 50,
    maximumAmount: 50000,
    taxRate: 0.06,
    processingFeeRate: 0.03
  })
  
  // 越南：VNPay + Stripe
  await configManager.setCountryConfig({
    country: 'VN',
    currency: 'VND',
    primaryProvider: 'vnpay',
    fallbackProviders: ['stripe'],
    supportedMethods: ['credit_card', 'bank_transfer', 'digital_wallet'],
    minimumAmount: 20000,
    maximumAmount: 50000000,
    taxRate: 0.1,
    processingFeeRate: 0.03
  })
}

// =============================================
// 3. 支付編排器使用範例
// =============================================

/**
 * 支付編排器使用範例
 * 展示如何使用編排器來自動選擇最佳支付提供商
 */
async function paymentOrchestratorExample() {
  const orchestrator = new PaymentOrchestrator()
  
  // 建立支付請求
  const request: PaymentRequest = {
    orderId: 'ORD-20231125-002',
    restaurantId: 1,
    amount: 8800,
    currency: 'TWD',
    country: 'TW',
    method: 'credit_card',
    customerInfo: {
      email: 'user@example.com',
      name: '李小華'
    }
  }
  
  try {
    // 編排器會自動選擇最佳提供商並處理支付
    const result = await orchestrator.processPayment(request)
    
    console.log('編排器處理結果:', {
      success: result.success,
      transactionId: result.transactionId,
      status: result.status
    })
    
  } catch (error) {
    console.error('編排器處理失敗:', error)
  }
}

// =============================================
// 4. 退款處理範例
// =============================================

/**
 * 退款處理範例
 * 展示如何處理全額和部分退款
 */
async function refundExample() {
  const paymentService = new PaymentService({ database: {} })
  
  // 全額退款
  const fullRefundRequest: RefundRequest & { transactionId: string } = {
    transactionId: 'TXN-12345678',
    amount: 12500, // 與原交易金額相同
    reason: 'customer_request'
    // description: '客戶要求退款'
  }
  
  try {
    const fullRefundResult = await paymentService.refundPayment(fullRefundRequest)
    
    if (fullRefundResult.success) {
      console.log('全額退款成功:', fullRefundResult.refundId)
    }
    
  } catch (error) {
    console.error('全額退款失敗:', error)
  }
  
  // 部分退款
  const partialRefundRequest: RefundRequest & { transactionId: string } = {
    transactionId: 'TXN-87654321',
    amount: 3000, // 部分金額
    reason: 'item_unavailable'
    // description: '部分商品缺貨，退還差額'
  }
  
  try {
    const partialRefundResult = await paymentService.refundPayment(partialRefundRequest)
    
    if (partialRefundResult.success) {
      console.log('部分退款成功:', partialRefundResult.refundId)
    }
    
  } catch (error) {
    console.error('部分退款失敗:', error)
  }
}

// =============================================
// 5. 錯誤處理和重試範例
// =============================================

/**
 * 錯誤處理和重試範例
 * 展示如何處理支付失敗和實作重試機制
 */
async function errorHandlingExample() {
  const paymentService = new PaymentService({ database: {} })
  
  const request: PaymentRequest = {
    orderId: 'ORD-20231125-003',
    restaurantId: 1,
    amount: 5600,
    currency: 'TWD',
    country: 'TW',
    method: 'credit_card',
    customerInfo: {
      email: 'test@example.com',
      name: '測試用戶'
    }
  }
  
  const maxRetries = 3
  let retryCount = 0
  
  while (retryCount < maxRetries) {
    try {
      const result = await paymentService.createPayment(request)
      
      if (result.success) {
        console.log('支付成功 (重試次數:', retryCount, ')')
        break
      } else {
        // 根據錯誤類型決定是否重試
        if (shouldRetry(result.error)) {
          retryCount++
          console.log(`支付失敗，準備第 ${retryCount} 次重試:`, result.error)
          
          // 等待一段時間再重試（指數退避）
          await delay(Math.pow(2, retryCount) * 1000)
        } else {
          console.log('不可重試的錯誤:', result.error)
          break
        }
      }
      
    } catch (error) {
      retryCount++
      console.error(`支付異常 (重試 ${retryCount}):`, error)
      
      if (retryCount >= maxRetries) {
        throw new Error('超過最大重試次數，支付失敗')
      }
      
      await delay(Math.pow(2, retryCount) * 1000)
    }
  }
}

// =============================================
// 輔助函數
// =============================================

/**
 * 判斷是否應該重試
 */
function shouldRetry(error: any): boolean {
  const retryableErrors = [
    'network_error',
    'timeout',
    'temporary_failure',
    'rate_limited'
  ]
  
  return retryableErrors.includes(error.code)
}

/**
 * 延遲函數
 */
function delay(ms: number): Promise<void> {
  return new Promise(resolve => setTimeout(resolve, ms))
}

/**
 * 更新訂單狀態（模擬）
 */
async function updateOrderStatus(orderId: string, status: string): Promise<void> {
  console.log(`更新訂單 ${orderId} 狀態為: ${status}`)
  // 實際實作會更新資料庫
}

/**
 * 記錄支付失敗（模擬）
 */
async function logPaymentFailure(orderId: string, error: any): Promise<void> {
  console.log(`記錄訂單 ${orderId} 支付失敗:`, error)
  // 實際實作會寫入日誌系統
}

// =============================================
// 匯出範例函數供測試使用
// =============================================

export {
  basicPaymentExample,
  multiCountryPaymentExample,
  paymentOrchestratorExample,
  refundExample,
  errorHandlingExample
}
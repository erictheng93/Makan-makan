            status: 'succeeded'
          }
        }
      }

      // 注意：實際測試需要正確的簽名驗證
      // 這裡只測試 webhook 處理邏輯的結構
      expect(webhookPayload.type).toBe('payment_intent.succeeded')
      expect(webhookPayload.data.object.status).toBe('succeeded')
    })
    */
  })

  describe('5. 錯誤處理測試', () => {
    test('應該正確處理無效的支付請求', async () => {
      const invalidRequest = {
        // 缺少必要欄位
        orderId: '',
        restaurantId: 0,
        country: 'INVALID' as CountryCode,
        currency: 'INVALID',
        amount: -1,
        method: 'invalid_method'
      }

      // 驗證請求會失敗
      expect(invalidRequest.orderId).toBe('')
      expect(invalidRequest.amount).toBeLessThan(0)
    })

    test('應該正確處理不支援的國家', async () => {
      const unsupportedCountryRequest: PaymentRequest = {
        orderId: 'ORDER_123',
        restaurantId: 1,
        country: 'US' as CountryCode, // 不支援的國家
        currency: 'TWD',
        amount: 100,
        method: 'credit_card'
      }

      // 這應該會被拒絕
      expect(unsupportedCountryRequest.country).toBe('US')
    })
  })

  describe('6. 安全性測試', () => {
    test('應該正確驗證 webhook 簽名', () => {
      // 模擬簽名驗證邏輯
      const payload = 'test_payload'
      const signature = 'test_signature'
      const secret = 'test_secret'

      // 實際實現會使用密碼學函式驗證
      expect(payload).toBeDefined()
      expect(signature).toBeDefined()
      expect(secret).toBeDefined()
    })

    test('應該正確處理敏感配置資訊', () => {
      // 確保敏感資訊不會被記錄或暴露
      const sensitiveConfig = {
        secretKey: 'sk_test_sensitive',
        webhookSecret: 'whsec_sensitive'
      }

      // 這些值不應該出現在日誌中
      expect(sensitiveConfig.secretKey).toMatch(/^sk_test_/)
      expect(sensitiveConfig.webhookSecret).toMatch(/^whsec_/)
    })
  })
})

// 整合測試輔助函數
export class PaymentTestUtils {
  static createMockPaymentRequest(overrides?: Partial<PaymentRequest>): PaymentRequest {
    return {
      orderId: 'ORDER_TEST_' + Date.now(),
      restaurantId: 1,
      country: 'TW',
      currency: 'TWD',
      amount: 100,
      method: 'credit_card',
      customerInfo: {
        name: '測試客戶',
        email: 'test@example.com',
        phone: '0912345678'
      },
      returnUrl: 'https://test.com/return',
      cancelUrl: 'https://test.com/cancel',
      ...overrides
    }
  }

  static createMockWebhookPayload(provider: string, status: string = 'completed') {
    switch (provider) {
      case 'stripe':
        return {
          id: 'evt_test_' + Date.now(),
          type: status === 'completed' ? 'payment_intent.succeeded' : 'payment_intent.payment_failed',
          data: {
            object: {
              id: 'pi_test_' + Date.now(),
              status: status === 'completed' ? 'succeeded' : 'failed'
            }
          }
        }
      
      case 'ecpay':
        return {
          MerchantID: '2000132',
          MerchantTradeNo: 'TEST_' + Date.now(),
          RtnCode: status === 'completed' ? '1' : '0',
          RtnMsg: status === 'completed' ? '交易成功' : '交易失敗',
          TradeNo: 'ECPay_' + Date.now(),
          TradeAmt: '100',
          PaymentDate: new Date().toISOString(),
          CheckMacValue: 'mock_check_mac_value'
        }
      
      default:
        return {}
    }
  }
}
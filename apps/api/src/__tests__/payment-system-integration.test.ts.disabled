      expect(stripeProvider.supportedCountries).toContain('TW')
      expect(stripeProvider.validateConfig()).toBe(true)
    })
    */

    test('ECPay 提供商應該正確初始化', () => {
      const ecpayProvider = new ECPayProvider({
        name: 'ecpay',
        displayName: 'ECPay',
        isActive: true,
        supportedCountries: ['TW'],
        supportedMethods: ['ecpay', 'credit_card'],
        testMode: true,
        config: {},
        ecpayConfig: {
          merchantId: '2000132',
          hashKey: 'test_hash_key',
          hashIV: 'test_hash_iv',
          checkoutUrl: 'https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5',
          queryUrl: 'https://payment-stage.ecpay.com.tw/Cashier/QueryTradeInfo/V5',
          testMode: true,
          returnUrl: 'https://test.com/return',
          notifyUrl: 'https://test.com/notify',
          clientBackUrl: 'https://test.com/back',
          itemName: 'Test Item',
          paymentTimeout: 1800
        }
      })

      expect(ecpayProvider.name).toBe('ecpay')
      expect(ecpayProvider.supportedCountries).toContain('TW')
      expect(ecpayProvider.validateConfig()).toBe(true)
    })

    test('iPay88 提供商應該正確初始化', () => {
      const ipay88Provider = new iPay88Provider({
        name: 'ipay88',
        displayName: 'iPay88',
        isActive: true,
        supportedCountries: ['MY'],
        supportedMethods: ['fpx', 'credit_card'],
        testMode: true,
        config: {},
        ipay88Config: {
          merchantCode: 'M12345',
          merchantKey: 'test_key',
          paymentUrl: 'https://sandbox.ipay88.com.my/epayment/entry.asp',
          queryUrl: 'https://sandbox.ipay88.com.my/epayment/enquiry.asp',
          responseUrl: 'https://test.com/response',
          backendUrl: 'https://test.com/backend',
          testMode: true,
          currency: 'MYR',
          country: 'MY',
          language: 'UTF-8'
        }
      })

      expect(ipay88Provider.name).toBe('ipay88')
      expect(ipay88Provider.supportedCountries).toContain('MY')
      expect(ipay88Provider.validateConfig()).toBe(true)
    })

    test('VNPay 提供商應該正確初始化', () => {
      const vnpayProvider = new VNPayProvider({
        name: 'vnpay',
        displayName: 'VNPay',
        isActive: true,
        supportedCountries: ['VN'],
        supportedMethods: ['bank_transfer', 'momo'],
        testMode: true,
        config: {},
        vnpayConfig: {
          tmnCode: 'TESTCODE',
          hashSecret: 'test_secret',
          paymentUrl: 'https://sandbox.vnpayment.vn/paymentv2/vpcpay.html',
          returnUrl: 'https://test.com/return',
          ipnUrl: 'https://test.com/ipn',
          version: '2.1.0',
          command: 'pay',
          orderType: 'other',
          locale: 'vn',
          currCode: 'VND',
          timeZone: '+07:00'
        }
      })

      expect(vnpayProvider.name).toBe('vnpay')
      expect(vnpayProvider.supportedCountries).toContain('VN')
      expect(vnpayProvider.validateConfig()).toBe(true)
    })
  })

  describe('3. 支付流程測試', () => {
    test('應該能夠創建支付請求', async () => {
      const paymentRequest: PaymentRequest = {
        orderId: 'ORDER_123',
        restaurantId: 1,
        country: 'TW',
        currency: 'TWD',
        amount: 100,
        method: 'credit_card',
        customerInfo: {
          name: '測試客戶',
          email: 'test@example.com',
          phone: '0912345678'
        },
        returnUrl: 'https://test.com/return',
        cancelUrl: 'https://test.com/cancel'
      }

      // 注意：這個測試需要實際的支付服務初始化
      // 在實際環境中，這會創建一個真實的支付請求
      expect(paymentRequest.orderId).toBe('ORDER_123')
      expect(paymentRequest.amount).toBe(100)
      expect(paymentRequest.currency).toBe('TWD')
    })

    test('應該能夠查詢支付狀態', async () => {
      // 模擬支付狀態查詢
      const transactionId = 'txn_test_123'
      const status = 'pending' // 模擬狀態
      
      expect(transactionId).toBe('txn_test_123')
      expect(status).toBe('pending')
    })
  })

  describe('4. Webhook 處理測試', () => {
    /* Disabled - StripeProvider is disabled
    test('應該能夠處理 Stripe Webhook', async () => {

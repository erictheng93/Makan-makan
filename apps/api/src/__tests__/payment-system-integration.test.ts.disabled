/**
 * 支付系統整合測試
 * 
 * 此測試文件驗證以下功能：
 * 1. 支付服務初始化
 * 2. 支付提供商註冊
 * 3. 支付創建流程
 * 4. Webhook 處理
 * 5. 支付狀態查詢
 * 6. 配置管理
 */

import { describe, test, expect, beforeAll, afterAll } from 'vitest'
import { PaymentService } from '../services/PaymentService'
import { PaymentConfigManager } from '../services/PaymentConfigManager'
// import { StripeProvider } from '../services/providers/StripeProvider' // Disabled
import { ECPayProvider } from '../services/providers/ECPayProvider'
import { iPay88Provider } from '../services/providers/iPay88Provider'
import { VNPayProvider } from '../services/providers/VNPayProvider'
import type { PaymentRequest, CountryCode } from '@makanmakan/shared-types'

// 模擬資料庫
const mockDB = {
  prepare: (sql: string) => ({
    get: (param?: any) => {
      // 模擬資料庫查詢結果
      if (sql.includes('payment_providers')) {
        return {
          id: 1,
          name: 'stripe',
          display_name: 'Stripe',
          is_active: 1,
          supported_countries: JSON.stringify(['TW', 'MY', 'VN']),
          supported_methods: JSON.stringify(['credit_card', 'debit_card']),
          test_mode: 1,
          webhook_endpoint: '/api/v1/payments/webhook/stripe'
        }
      }
      if (sql.includes('country_payment_configs')) {
        return {
          country_code: 'TW',
          currency_code: 'TWD',
          supported_methods: JSON.stringify(['credit_card', 'ecpay']),
          primary_provider: 'stripe',
          fallback_providers: JSON.stringify(['ecpay']),
          minimum_amount: 1,
          maximum_amount: 1000000,
          tax_rate: 0.05,
          processing_fee_rate: 0.03
        }
      }
      return null
    },
    all: () => [
      {
        id: 1,
        name: 'stripe',
        display_name: 'Stripe',
        is_active: 1,
        supported_countries: JSON.stringify(['TW', 'MY', 'VN']),
        supported_methods: JSON.stringify(['credit_card', 'debit_card']),
        test_mode: 1,
        webhook_endpoint: '/api/v1/payments/webhook/stripe'
      }
    ],
    run: () => ({ changes: 1, lastInsertRowid: 1 })
  })
}

describe('支付系統整合測試', () => {
  let paymentService: PaymentService
  let configManager: PaymentConfigManager

  beforeAll(async () => {
    // 初始化測試環境
    configManager = new PaymentConfigManager(mockDB as any)
    paymentService = new PaymentService({
      database: mockDB,
      orchestratorConfig: {
        defaultTimeout: 30000,
        maxRetries: 3,
        fallbackEnabled: true
      }
    })
  })

  describe('1. 配置管理測試', () => {
    test('應該能夠獲取支付提供商配置', async () => {
      const provider = await configManager.getPaymentProvider('stripe')
      
      expect(provider).toBeDefined()
      expect(provider?.name).toBe('stripe')
      expect(provider?.supportedCountries).toContain('TW')
      expect(provider?.supportedMethods).toContain('credit_card')
    })

    test('應該能夠獲取國家支付配置', async () => {
      const config = await configManager.getCountryConfig('TW')
      
      expect(config).toBeDefined()
      expect(config?.country).toBe('TW')
      expect(config?.currency).toBe('TWD')
      expect(config?.primaryProvider).toBe('stripe')
    })

    test('應該能夠驗證配置有效性', async () => {
      const validation = await configManager.validateConfiguration()
      
      expect(validation).toBeDefined()
      expect(validation.valid).toBe(true)
      expect(validation.errors).toHaveLength(0)
    })
  })

  describe('2. 支付提供商測試', () => {
    /* Disabled - StripeProvider is disabled
    test('Stripe 提供商應該正確初始化', () => {

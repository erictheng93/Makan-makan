# Cloudflare Workers configuration - Simplified for development
name = "makanmasak-api"
main = "src/index.ts"
compatibility_date = "2024-08-01"
compatibility_flags = ["nodejs_compat", "streams_enable_constructors"]

# Variables (non-sensitive only)
[vars]
NODE_ENV = "development"
API_VERSION = "v1"
API_BASE_URL = "http://localhost:8787"

# D1 Database bindings
[[d1_databases]]
binding = "DB"
database_name = "makanmasak-local"
database_id = "local"

# KV namespace for caching
[[kv_namespaces]]
binding = "CACHE_KV"
id = "makanmasak-cache-dev"
preview_id = "makanmasak-cache-preview"

# Rate limiting KV namespace
[[kv_namespaces]]
binding = "RATE_LIMIT_KV"
id = "makanmasak-ratelimit-dev"
preview_id = "makanmasak-ratelimit-preview"
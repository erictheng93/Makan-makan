{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,
    "paths": {
      "@makanmakan/database": ["../../packages/database/src"],
      "@makanmakan/database/*": ["../../packages/database/src/*"],
      "@makanmakan/shared-types": ["../../packages/shared-types/src"],
      "@makanmakan/shared-types/*": ["../../packages/shared-types/src/*"],
      "@makanmakan/utils": ["../../packages/utils/src"],
      "@makanmakan/utils/*": ["../../packages/utils/src/*"],
      "@makanmakan/queue-core": ["../../packages/queue-core/src"],
      "@makanmakan/queue-service": ["../../packages/queue-service/src"]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/database/src/**/*",
    "../../packages/shared-types/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/shared/templates",
    "../../packages/database/src/**/__tests__/**",
    "../../packages/database/src/**/*.test.ts",
    "../../packages/database/src/testing/**",
    "../../packages/utils/src/performance-monitor.ts",
    "../../packages/utils/src/error-tracking.ts",
    "../../packages/utils/**/*"
  ]
}

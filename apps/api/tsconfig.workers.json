{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": false,
    "skipDefaultLibCheck": true,
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@makanmakan/database": ["../../packages/database/src"],
      "@makanmakan/shared-types": ["../../packages/shared-types/src"],
      "@makanmakan/queue-core": ["../../packages/queue-core/src"],
      "@makanmakan/queue-service": ["../../packages/queue-service/src"]
    }
  },
  "include": [
    "src/routes/queue-modular.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/shared/templates",
    "**/*.test.ts",
    "**/*.disabled.ts"
  ]
}
# Kitchen Display — development environment template
#
# The real .env.development is committed and provides team-shared defaults.
# Copy this file to .env.development.local to override any value for your
# personal setup. .env.development.local is gitignored.
#
#   cp .env.development.example .env.development.local

# API base path — proxied by Vite to the local Worker (see vite.config.ts)
VITE_API_BASE_URL=/api/v1

# Main API WebSocket — port 8787
VITE_WS_BASE_URL=ws://localhost:8787

VITE_APP_ENV=development

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,
    "paths": {
      "@makanmasak/database": ["../../packages/database/src"],
      "@makanmasak/database/*": ["../../packages/database/src/*"],
      "@makanmasak/shared-types": ["../../packages/shared-types/src"],
      "@makanmasak/shared-types/*": ["../../packages/shared-types/src/*"],
      "@makanmasak/utils": ["../../packages/utils/src"],
      "@makanmasak/utils/*": ["../../packages/utils/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "../../packages/utils/src/performance-monitor.ts",
    "../../packages/utils/src/error-tracking.ts",
    "../../packages/utils/**/*"
  ]
}

{
  "name": "@makanmakan/management-api",
  "version": "1.0.0",
  "description": "Central management API for MakanMakan hybrid deployment",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --env=\"\"",
    "build:staging": "wrangler deploy --dry-run --env staging",
    "build:prod": "wrangler deploy --dry-run --env production",
    "deploy": "node -e \"console.error('Refusing unqualified deploy. Use pnpm run deploy:staging or pnpm run deploy:prod.'); process.exit(1)\"",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest",
    "test:run": "vitest run",
    "test:real-integration": "vitest --config vitest.real-integration.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.5.0",
    "@makanmakan/utils": "workspace:*",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.24",
    "pinyin-pro": "^3.28.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260603.1",
    "@makanmakan/database": "workspace:*",
    "@makanmakan/shared-types": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4",
    "wrangler": "^4.101.0"
  }
}

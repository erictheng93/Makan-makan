{
  "name": "@makanmakan/image-processor",
  "version": "1.0.0",
  "description": "Cloudflare Workers-based image processing service for MakanMakan",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --persist-to ../../.wrangler/shared-state --inspector-port 9234",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "build": "tsc && wrangler deploy --dry-run --env=\"\"",
    "build:prod": "tsc && wrangler deploy --dry-run --env production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "cloudflare-workers",
    "image-processing",
    "image-optimization",
    "restaurant-management"
  ],
  "author": "MakanMakan Team",
  "license": "MIT",
  "dependencies": {
    "@makanmakan/database": "workspace:*",
    "@makanmakan/shared-types": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.24",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "^8.57.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.114.0"
  }
}

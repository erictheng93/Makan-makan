# Tier 2 staging secrets — third-party service API keys.
# Copy this file to .staging.secrets.env (gitignored) and fill in real values.
# Empty values are skipped by scripts/provision-secrets-staging.sh.
# Tier 1 secrets (JWT_SECRET etc.) are auto-generated — do NOT add them here.

# === Email (Resend — https://resend.com) ===
# Used by apps/api for customer notifications.
RESEND_API_KEY=

# === SMS (Twilio — https://www.twilio.com/console) ===
# Used by apps/api for SMS notifications.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# === Slack alerting ===
# Incoming webhook for error/deploy notifications.
# Create at: https://api.slack.com/apps → Your App → Incoming Webhooks
SLACK_WEBHOOK_URL=

# === Stripe (https://dashboard.stripe.com/test/apikeys) ===
# Use TEST mode keys for staging. Live keys go to prod.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === Cloudflare Images (https://dash.cloudflare.com/?to=/:account/api-tokens) ===
# Create token with permissions: Account → Cloudflare Images:Edit
# Used by apps/image-processor for menu photo uploads/transforms.
CLOUDFLARE_IMAGES_API_TOKEN=

# === Management API email provider ===
# (May reuse RESEND_API_KEY value or use a different provider's key)
EMAIL_API_KEY=

# === Optional: alert recipient ===
# Comma-separated email addresses for high-severity alerts (api worker).
ALERT_EMAIL_TO=

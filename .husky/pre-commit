# 運行 lint-staged 檢查
pnpm lint-staged

# 視覺回歸 baseline 平台檢查：拒絕 *-darwin.png / *-win32.png
# CI 只接受 *-linux.png，詳見 scripts/update-visual-baselines.sh
node scripts/check-visual-baselines.cjs
node scripts/audit-module-gates.cjs

# wrangler answers its own destructive-command confirmation when stdin is not a
# terminal, so `d1 time-travel restore`, `d1 delete` and `wrangler delete` must
# stay out of workflows, scripts, package scripts and hooks. CI checks this too;
# here it fails before the commit exists.
node scripts/check-no-automated-destructive-wrangler.cjs

# The palette is the five iOS hues in DESIGN.md, defined once in
# design-tokens.js. This rejects the hues the system does not have (purple,
# indigo, violet, fuchsia, pink) and raw hex duplicates of a token, which is how
# 337 off-palette classes accumulated across the five apps before 2026-09-02.
node scripts/check-design-palette.cjs

# Factory 使用快速檢查（僅針對測試文件）
# Use --diff-filter=ACM here too, otherwise a commit that only DELETES a
# spec file enters this branch (the outer grep matches the deletion) and
# then the inner grep's exit-1 propagates as the hook's final exit code.
if git diff --cached --name-only --diff-filter=ACM | grep -qE '\.test\.ts$|\.spec\.ts$'; then
  echo "🧪 檢查測試文件 factory 使用..."

  # 只檢查暫存的測試文件 (|| true so empty grep does not fail the hook)
  STAGED_TEST_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.test\.ts$|\.spec\.ts$' || true)

  if [ -n "$STAGED_TEST_FILES" ]; then
    # 簡單檢查：是否有 factory 使用但沒有 resetAllFactories
    for file in $STAGED_TEST_FILES; do
      if [ -f "$file" ]; then
        CONTENT=$(cat "$file")

        # 檢查是否使用了 factory
        if echo "$CONTENT" | grep -qE 'Factory\.(build|buildList)'; then
          # 檢查是否有 resetAllFactories
          if ! echo "$CONTENT" | grep -q 'resetAllFactories'; then
            echo "⚠️  警告: $file 使用了 factory 但缺少 resetAllFactories()"
            echo "   建議在 beforeEach 中添加："
            echo "   beforeEach(() => {"
            echo "     resetAllFactories()"
            echo "   })"
            echo ""
          fi
        fi
      fi
    done
  fi
fi
